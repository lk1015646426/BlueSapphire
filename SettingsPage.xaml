<Page
    x:Class="BlueSapphire.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource BgColor}"
    Loaded="SettingsPage_Loaded"
    mc:Ignorable="d">

    <Grid Padding="20" MaxWidth="1180" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="工作台配置" Style="{StaticResource TextStyle_Caption}" Foreground="{ThemeResource AccentPrimary}"/>
            <TextBlock Text="设置" Style="{StaticResource TextStyle_PageTitle}"/>
            <TextBlock Text="管理外观、AI 服务和第三方扩展。高风险扩展默认保持停用。"
                       Foreground="{ThemeResource TextSecondary}" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Spacing="18">

                <TextBlock Text="常规" Style="{StaticResource TextStyle_Title}" Margin="4,0,0,0"/>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="主题配色" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="同时改变背景、面板、边框、文字和信号色。"
                                           Style="{StaticResource TextStyle_Caption}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="8 套" Style="{StaticResource TextStyle_Caption}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="ThemePresetGrid" Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <RadioButton x:Name="PresetDefault" GroupName="ThemePreset" Tag="default"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="默认暖陶">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Width="30" Height="24">
                                        <Rectangle Fill="#F8F8F6"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#FAF9F5"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#C96442"/>
                                    </Grid><TextBlock Text="默认暖陶"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetAzure" Grid.Row="1" GroupName="ThemePreset" Tag="sky"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="天蓝">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Width="30" Height="24"><Rectangle Fill="#FFFFFF"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#F7F8F8"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#1E9DF1"/></Grid><TextBlock Text="天蓝"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetCobalt" Grid.Row="2" GroupName="ThemePreset" Tag="cobalt"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="钴蓝">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="30" Height="24"><Rectangle Fill="#FFFFFF"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#F3F5F7"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#1166D4"/></Grid><TextBlock Text="钴蓝"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetGraphite" Grid.Row="3" GroupName="ThemePreset" Tag="graphite"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="石墨">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="30" Height="24"><Rectangle Fill="#FCFCFC"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#EBEBEB"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#000000"/></Grid><TextBlock Text="石墨"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetLagoon" Grid.Row="4" GroupName="ThemePreset" Tag="lagoon"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="泻湖">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="30" Height="24"><Rectangle Fill="#F8FCFB"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#E3FAFC"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#00B298"/></Grid><TextBlock Text="泻湖"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetInk" Grid.Row="5" GroupName="ThemePreset" Tag="ink"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="墨色">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="30" Height="24"><Rectangle Fill="#F3F9FF"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#F8FCFF"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#000102"/></Grid><TextBlock Text="墨色"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetOchre" Grid.Row="6" GroupName="ThemePreset" Tag="ochre"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="赭橙">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="30" Height="24"><Rectangle Fill="#FCF8F3"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#F3EADE"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#F97015"/></Grid><TextBlock Text="赭橙"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetSepia" Grid.Row="7" GroupName="ThemePreset" Tag="sepia"
                                         Checked="ThemePreset_Checked" AutomationProperties.Name="棕褐">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="30" Height="24"><Rectangle Fill="#F9F9F9"/><Rectangle Width="10" HorizontalAlignment="Center" Fill="#FFDFB5"/><Rectangle Width="10" HorizontalAlignment="Right" Fill="#644A40"/></Grid><TextBlock Text="棕褐"/></StackPanel>
                            </RadioButton>
                        </Grid>
                    </Grid>
                </Border>

                <!-- General settings: two balanced columns -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Appearance -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentPrimaryBg}">
                                    <FontIcon Glyph="&#xE790;" FontSize="17" Foreground="{StaticResource AccentPrimary}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="外观与体验" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="调整工作台的主题、密度和动效偏好。" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource BorderSubtle}"/>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="应用主题" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="可跟随 Windows 的颜色模式。"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ThemeComboBox_SelectionChanged"
                                          AutomationProperties.Name="应用主题">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色" Tag="Light"/>
                                    <ComboBoxItem Content="深色" Tag="Dark"/>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="界面字号" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="调整默认控件与正文的阅读尺寸。" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <RadioButton x:Name="FontSmall" GroupName="UiFontSize" Tag="small" Content="小" Checked="UiFontSize_Checked"/>
                                    <RadioButton x:Name="FontStandard" GroupName="UiFontSize" Tag="standard" Content="标准" Checked="UiFontSize_Checked"/>
                                    <RadioButton x:Name="FontMedium" GroupName="UiFontSize" Tag="medium" Content="中" Checked="UiFontSize_Checked"/>
                                    <RadioButton x:Name="FontLarge" GroupName="UiFontSize" Tag="large" Content="大" Checked="UiFontSize_Checked"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="减少动态效果" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="停用页面入场和持续动画，适合对动效敏感的用户。"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ReduceMotionSwitch"
                                              Grid.Column="1"
                                              Toggled="ReduceMotionSwitch_Toggled"
                                              OnContent="开"
                                              OffContent="关"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="减少动态效果"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AI service -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentInspectBg}">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="{StaticResource AccentInspect}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="AI 服务" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="密钥使用当前 Windows 账户加密保存。" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource BorderSubtle}"/>

                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="提供商"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="ApiProviderComboBox"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ApiProviderComboBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek 官方 API" Tag="Official"/>
                                    <ComboBoxItem Content="硅基流动（SiliconFlow）" Tag="SiliconFlow"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1"
                                           Text="API 密钥"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <PasswordBox x:Name="DeepSeekApiKeyBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             PlaceholderText="输入你的 sk-… 密钥"
                                             PasswordChar="•"
                                             PasswordRevealMode="Peek"
                                             PasswordChanged="DeepSeekApiKeyBox_PasswordChanged"/>

                                <TextBlock Grid.Row="2"
                                           Text="模型"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ApiModelComboBox"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="请先测试连接并获取模型"
                                              SelectionChanged="ApiModelComboBox_SelectionChanged"
                                              DropDownOpened="ApiModelComboBox_DropDownOpened"/>
                                    <Button x:Name="RefreshModelsBtn"
                                            Grid.Column="1"
                                            Width="40"
                                            Height="32"
                                            Style="{StaticResource CompactButtonStyle}"
                                            ToolTipService.ToolTip="测试连接并获取模型列表"
                                            Click="RefreshModelsBtn_Click"
                                            AutomationProperties.Name="测试连接并获取模型列表">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="扩展与连接"
                           Style="{StaticResource TextStyle_Title}"
                           Margin="4,10,0,0"/>

                <!-- Extensions: two columns, with Agent skills spanning the full width -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MCP -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentSafeBg}">
                                    <FontIcon Glyph="&#xE968;" FontSize="17" Foreground="{StaticResource AccentSafe}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="MCP 服务器" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="本机进程扩展，添加后默认停止。"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="AddMcpBtn"
                                        Grid.Column="2"
                                        Content="添加服务器"
                                        Style="{StaticResource ActionButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="AddMcpBtn_Click"/>
                            </Grid>

                            <TextBlock Text="启动前会显示完整命令；环境变量使用当前 Windows 账户加密保存。"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"/>

                            <ItemsControl x:Name="McpServersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListItemBorderStyle}" Margin="0,4,0,0">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Command}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="12"/>
                                                    <Button Content="{Binding ActionText}" Tag="{Binding Id}" Style="{StaticResource CompactButtonStyle}" Click="ToggleMcpBtn_Click"/>
                                                    <Button Content="删除" Tag="{Binding Id}" Style="{StaticResource DangerActionButtonStyle}" Click="DeleteMcpBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Remote OpenAPI -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentInspectBg}">
                                    <FontIcon Glyph="&#xE774;" FontSize="17" Foreground="{StaticResource AccentInspect}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="在线 API 扩展" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="远程 OpenAPI 规范，启用前必须审核。"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="AddSkillBtn"
                                        Grid.Column="2"
                                        Content="添加网址"
                                        Style="{StaticResource ActionButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="AddSkillBtn_Click"/>
                            </Grid>

                            <TextBlock Text="规范会先验证并保持“待审核”；每次实际调用仍会再次询问。"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"/>

                            <ItemsControl x:Name="SkillsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Margin="0,4,0,0">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                                        <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="12"/>
                                                        <Button Content="{Binding ActionText}" Tag="{Binding Id}" Style="{StaticResource CompactButtonStyle}" Click="ToggleWebSkillBtn_Click"/>
                                                        <Button Content="删除" Tag="{Binding Id}" Style="{StaticResource DangerActionButtonStyle}" Click="DeleteSkillBtn_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Padding="10" Spacing="4">
                                                <TextBlock Text="{Binding NetworkStatusText}" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                                <TextBlock Text="{Binding TrustStatusText}" Foreground="{StaticResource AccentReview}" FontSize="13"/>
                                                <TextBlock Text="{Binding ToolCountText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{Binding TargetOrigin}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Agent skills -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentReviewBg}">
                                    <FontIcon Glyph="&#xE945;" FontSize="17" Foreground="{StaticResource AccentReview}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Agent 技能" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="提示词扩展，下载后默认不信任、不启用。"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="添加 Agent 技能"
                                        Style="{StaticResource ActionButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="AddAgentSkillBtn_Click"/>
                            </Grid>

                            <TextBlock Text="启用前请阅读来源、描述和指令预览；技能不能绕过操作确认和安全限制。"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"/>

                            <ItemsControl x:Name="AgentSkillsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListItemBorderStyle}" Margin="0,4,0,0">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" MaxLines="2"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentReview}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="{Binding ActionText}" Tag="{Binding Id}" Style="{StaticResource CompactButtonStyle}" Click="ReviewAgentSkillBtn_Click"/>
                                                    <Button Content="删除" Tag="{Binding Id}" Style="{StaticResource DangerActionButtonStyle}" Click="DeleteAgentSkillBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer and hidden update-log entry -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Spacing="6">
            <TextBlock Text="蓝宝石工具箱"
                       FontSize="12"
                       Foreground="{StaticResource TextFaint}"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="VersionButton"
                        Style="{StaticResource SubtleActionButtonStyle}"
                        MinHeight="0"
                        Padding="0"
                        Click="VersionButton_Click"
                        AutomationProperties.Name="应用版本号">
                    <TextBlock Text="{x:Bind AppDisplayVersion, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPrimary}"/>
                </Button>
                <TextBlock Text="·" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind AppBuildDate, Mode=OneWay}"
                           Foreground="{StaticResource TextFaint}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
