<Page
    x:Class="BlueSapphire.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePaddingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <StackPanel Grid.Row="0" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,0,30">
            <TextBlock Text="系统设置" Style="{StaticResource TextStyle_PageTitle}" CharacterSpacing="80" Margin="0,0,0,15"/>
            <Rectangle Height="1" HorizontalAlignment="Stretch">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{Binding Color, Source={StaticResource AccentCyan}}" Offset="0"/>
                        <GradientStop Color="{Binding Color, Source={StaticResource AccentCyanBg}}" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </StackPanel>

        <!-- 核心设置区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Spacing="15">
                
                <TextBlock Text="通用配置" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="5,0,0,0" CharacterSpacing="20"/>
                
                <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <!-- 粒子引擎设置 -->
                        <Grid Padding="25,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="神经网络粒子引擎" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" CharacterSpacing="25"/>
                                <TextBlock Text="开启或关闭背景的动态神经节点连线特效" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <ToggleSwitch x:Name="ParticleSwitch" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsOn="True" Margin="0"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BorderColor}" Margin="25,0"/>

                        <Grid Padding="25,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="外观与动态效果" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="主题可跟随系统；减少动态效果会停用粒子和持续动画。" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="220" Spacing="10">
                                <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" AutomationProperties.Name="应用主题">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色" Tag="Light"/>
                                    <ComboBoxItem Content="深色" Tag="Dark"/>
                                </ComboBox>
                                <ToggleSwitch x:Name="ReduceMotionSwitch"
                                              Header="减少动态效果"
                                              Toggled="ReduceMotionSwitch_Toggled"
                                              AutomationProperties.Name="减少动态效果"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BorderColor}" Margin="25,0"/>

                        <!-- AI 引擎设置 -->
                        <Grid Padding="25,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="AI 智能引擎" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" CharacterSpacing="25"/>
                                <TextBlock Text="配置智能引擎 API 密钥，解锁“蓝宝石”智能对话控制与自动日志分析功能。支持官方 DeepSeek 与硅基流动接口。" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center" Width="280">
                                <ComboBox x:Name="ApiProviderComboBox" HorizontalAlignment="Stretch" SelectionChanged="ApiProviderComboBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek 官方 API" Tag="Official"/>
                                    <ComboBoxItem Content="硅基流动 (SiliconFlow)" Tag="SiliconFlow"/>
                                </ComboBox>
                                <PasswordBox x:Name="DeepSeekApiKeyBox" HorizontalAlignment="Stretch" PlaceholderText="输入你的 sk-... 密钥" PasswordChar="•" PasswordRevealMode="Peek" PasswordChanged="DeepSeekApiKeyBox_PasswordChanged"/>
                                
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ApiModelComboBox" HorizontalAlignment="Stretch" PlaceholderText="请先测试连接并获取模型" SelectionChanged="ApiModelComboBox_SelectionChanged" DropDownOpened="ApiModelComboBox_DropDownOpened"/>
                                    <Button x:Name="RefreshModelsBtn" Grid.Column="1" Width="40" Height="32" ToolTipService.ToolTip="测试连接并获取模型列表" Click="RefreshModelsBtn_Click" AutomationProperties.Name="测试连接并获取模型列表">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="MCP 扩展插件" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="5,15,0,0" CharacterSpacing="20"/>
                
                <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Padding="25,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="外部 Model Context Protocol 服务器" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" CharacterSpacing="20"/>
                                <TextBlock Text="第三方 MCP 会在本机启动进程。添加后默认保持停止，需由你手动启动；环境变量会使用当前 Windows 账户加密保存。" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <Button x:Name="AddMcpBtn" Grid.Column="1" VerticalAlignment="Center" Content="添加新服务器" Click="AddMcpBtn_Click"/>
                        </Grid>

                        <ItemsControl x:Name="McpServersList" Margin="0,15,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                            <TextBlock Text="{Binding Command}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                                            <Button Content="{Binding ActionText}" Tag="{Binding Id}" Click="ToggleMcpBtn_Click"/>
                                            <Button Content="删除" Tag="{Binding Id}" Click="DeleteMcpBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Web API 技能 (在线挂载)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="5,15,0,0" CharacterSpacing="20"/>
                
                <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Padding="25,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="远程 OpenAPI 接口聚合" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" CharacterSpacing="20"/>
                                <TextBlock Text="远程规范会先验证并保持“待审核”。只有你确认目标服务后，接口才会加入 AI 工具列表；每次实际调用仍会再次询问。" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <Button x:Name="AddSkillBtn" Grid.Column="1" VerticalAlignment="Center" Content="添加技能网址" Click="AddSkillBtn_Click"/>
                        </Grid>

                        <ItemsControl x:Name="SkillsList" Margin="0,15,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                                                    <Button Content="{Binding ActionText}" Tag="{Binding Id}" Click="ToggleWebSkillBtn_Click"/>
                                                    <Button Content="删除" Tag="{Binding Id}" Click="DeleteSkillBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Padding="10">
                                            <TextBlock Text="{Binding NetworkStatusText}" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                            <TextBlock Text="{Binding TrustStatusText}" Foreground="{StaticResource AccentReview}" FontSize="13"/>
                                            <TextBlock Text="{Binding ToolCountText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="{Binding TargetOrigin}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Agent 提示词技能（需审核）" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="5,15,0,0" CharacterSpacing="20"/>

                <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Padding="25,20" Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="第三方 SKILL.md" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="下载后默认不信任、不启用。启用前请阅读来源、描述和指令预览；技能不能绕过操作确认和安全限制。" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="添加 Agent 技能" Click="AddAgentSkillBtn_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl x:Name="AgentSkillsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" MaxLines="2"/>
                                            <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentReview}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionText}" Tag="{Binding Id}" Click="ReviewAgentSkillBtn_Click"/>
                                            <Button Content="删除" Tag="{Binding Id}" Click="DeleteAgentSkillBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部版本信息 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="蓝宝石工具箱" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextFaint}" CharacterSpacing="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind AppDisplayVersion, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           CharacterSpacing="15"
                           Foreground="{StaticResource AccentCyan}"/>

                <TextBlock Text="|" Foreground="{StaticResource TextFaint}" FontSize="13" VerticalAlignment="Center" Margin="0,-2,0,0"/>

                <TextBlock Text="{x:Bind AppBuildDate, Mode=OneWay}" Foreground="{StaticResource TextFaint}" FontSize="13" VerticalAlignment="Center" CharacterSpacing="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
