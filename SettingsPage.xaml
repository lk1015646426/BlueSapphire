<Page
    x:Class="BlueSapphire.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40,40,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <StackPanel Grid.Row="0" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,0,0,30">
            <TextBlock Text="系统设置" FontSize="32" FontWeight="Bold" Foreground="White" CharacterSpacing="80" Margin="0,0,0,15"/>
            <Rectangle Height="1" HorizontalAlignment="Stretch">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#CC00FFFF" Offset="0"/>
                        <GradientStop Color="#0000FFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </StackPanel>

        <!-- 核心设置区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Spacing="15">
                
                <TextBlock Text="通用配置" FontSize="15" FontWeight="SemiBold" Foreground="#A0FFFFFF" Margin="5,0,0,0" CharacterSpacing="20"/>
                
                <Border Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <!-- 粒子引擎设置 -->
                        <Grid Padding="25,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="神经网络粒子引擎" FontSize="18" FontWeight="SemiBold" Foreground="#F0FFFFFF" CharacterSpacing="25"/>
                                <TextBlock Text="开启或关闭背景的动态神经节点连线特效" Foreground="#80FFFFFF" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <ToggleSwitch x:Name="ParticleSwitch" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsOn="True" Margin="0"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="25,0"/>

                        <!-- AI 引擎设置 -->
                        <Grid Padding="25,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="AI 智能引擎" FontSize="18" FontWeight="SemiBold" Foreground="#F0FFFFFF" CharacterSpacing="25"/>
                                <TextBlock Text="配置智能引擎 API 密钥，解锁“蓝宝石”智能对话控制与自动日志分析功能。支持官方 DeepSeek 与硅基流动接口。" Foreground="#80FFFFFF" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center" Width="280">
                                <ComboBox x:Name="ApiProviderComboBox" HorizontalAlignment="Stretch" SelectionChanged="ApiProviderComboBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepSeek 官方 API" Tag="Official"/>
                                    <ComboBoxItem Content="硅基流动 (SiliconFlow)" Tag="SiliconFlow"/>
                                </ComboBox>
                                <PasswordBox x:Name="DeepSeekApiKeyBox" HorizontalAlignment="Stretch" PlaceholderText="输入你的 sk-... 密钥" PasswordChar="•" PasswordRevealMode="Peek" PasswordChanged="DeepSeekApiKeyBox_PasswordChanged"/>
                                
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ApiModelComboBox" HorizontalAlignment="Stretch" PlaceholderText="请先测试连接并获取模型" SelectionChanged="ApiModelComboBox_SelectionChanged" DropDownOpened="ApiModelComboBox_DropDownOpened"/>
                                    <Button x:Name="RefreshModelsBtn" Grid.Column="1" Width="40" Height="32" ToolTipService.ToolTip="测试连接并获取模型列表" Click="RefreshModelsBtn_Click">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="MCP 扩展插件" FontSize="15" FontWeight="SemiBold" Foreground="#A0FFFFFF" Margin="5,15,0,0" CharacterSpacing="20"/>
                
                <Border Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
                    <StackPanel Padding="25,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="外部 Model Context Protocol 服务器" FontSize="18" FontWeight="SemiBold" Foreground="#F0FFFFFF" CharacterSpacing="20"/>
                                <TextBlock Text="在此添加外部的 MCP 命令行程序。蓝宝石的 AI 大脑将自动挂载它们提供的工具（如网页搜索、操作 GitHub 等）。" Foreground="#80FFFFFF" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <Button x:Name="AddMcpBtn" Grid.Column="1" VerticalAlignment="Center" Content="添加新服务器" Click="AddMcpBtn_Click"/>
                        </Grid>

                        <ItemsControl x:Name="McpServersList" Margin="0,15,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Command}" Foreground="#A0FFFFFF" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                                            <Button Content="删除" Tag="{Binding Id}" Click="DeleteMcpBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Web API 技能 (在线挂载)" FontSize="15" FontWeight="SemiBold" Foreground="#A0FFFFFF" Margin="5,15,0,0" CharacterSpacing="20"/>
                
                <Border Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
                    <StackPanel Padding="25,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="远程 OpenAPI 接口聚合" FontSize="18" FontWeight="SemiBold" Foreground="#F0FFFFFF" CharacterSpacing="20"/>
                                <TextBlock Text="只需填入含有标准 OpenAPI / Swagger 规范格式的 API 网址（例如 aihot 的在线技能），蓝宝石就能瞬间读取并掌握这些在线 Web 接口作为自己的技能。" Foreground="#80FFFFFF" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <Button x:Name="AddSkillBtn" Grid.Column="1" VerticalAlignment="Center" Content="添加技能网址" Click="AddSkillBtn_Click"/>
                        </Grid>

                        <ItemsControl x:Name="SkillsList" Margin="0,15,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="#A0FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                                                    <Button Content="删除" Tag="{Binding Id}" Click="DeleteSkillBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Padding="10">
                                            <TextBlock Text="{Binding NetworkStatusText}" Foreground="#D0FFFFFF" FontSize="13"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部版本信息 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0"
                    PointerPressed="SecretVersion_PointerPressed"
                    PointerEntered="SecretVersion_PointerEntered"
                    PointerExited="SecretVersion_PointerExited" 
                    Background="Transparent">
            
            <StackPanel.Resources>
                <Storyboard x:Name="VersionClickStoryboard">
                    <DoubleAnimation Storyboard.TargetName="VersionScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1.0" To="0.8" Duration="0:0:0.1" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="VersionScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1.0" To="0.8" Duration="0:0:0.1" AutoReverse="True"/>
                    <ColorAnimation Storyboard.TargetName="VersionBrush"
                                    Storyboard.TargetProperty="Color"
                                    From="#00FFFF" To="White" Duration="0:0:0.1" AutoReverse="True"/>
                </Storyboard>
            </StackPanel.Resources>

            <TextBlock Text="蓝宝石工具箱" FontSize="16" FontWeight="Bold" Foreground="#60FFFFFF" CharacterSpacing="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <TextBlock x:Name="VersionTextBlock" 
                           Text="{x:Bind AppDisplayVersion, Mode=OneWay}" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           CharacterSpacing="15" 
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.Foreground>
                        <SolidColorBrush x:Name="VersionBrush" Color="#00FFFF"/>
                    </TextBlock.Foreground>
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="VersionScale" ScaleX="1" ScaleY="1"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock Text="|" Foreground="#30FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0,-2,0,0"/>

                <TextBlock Text="{x:Bind AppBuildDate, Mode=OneWay}" Foreground="#50FFFFFF" FontSize="13" VerticalAlignment="Center" CharacterSpacing="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>