<Page
    x:Class="BlueSapphire.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40">
        <StackPanel Spacing="30">

            <StackPanel>
                <TextBlock Text="设置" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Settings &amp; Configuration" FontSize="14" Opacity="0.6" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Height="1" Background="#30FFFFFF" HorizontalAlignment="Stretch"/>

            <StackPanel Spacing="10">
                <TextBlock Text="视觉效果 (Visual)" FontSize="18" FontWeight="SemiBold" Foreground="#00CCFF"/>

                <Grid Background="#10FFFFFF" Padding="20" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="启用神经网络粒子背景" FontSize="16"/>
                        <TextBlock Text="关闭此选项可降低 GPU 占用，提升性能。" FontSize="12" Opacity="0.6" Margin="0,5,0,0"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="ParticleSwitch" 
                                  Grid.Column="1" 
                                  IsOn="True"/>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10" Margin="0,20,0,0">
                <TextBlock Text="关于 (About)" FontSize="18" FontWeight="SemiBold" Foreground="#00CCFF"/>

                <Grid Background="#10FFFFFF" Padding="20" CornerRadius="8">

                    <StackPanel Background="Transparent" 
                                PointerPressed="SecretVersion_PointerPressed"
                                PointerEntered="SecretVersion_PointerEntered"
                                PointerExited="SecretVersion_PointerExited"
                                HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Storyboard x:Name="VersionClickStoryboard">
                                <DoubleAnimation Storyboard.TargetName="VersionScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="0.8" Duration="0:0:0.1" AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="VersionScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="0.8" Duration="0:0:0.1" AutoReverse="True"/>
                                <ColorAnimation Storyboard.TargetName="VersionBrush"
                                                Storyboard.TargetProperty="Color"
                                                From="White" To="#00FFFF" Duration="0:0:0.1" AutoReverse="True"/>
                            </Storyboard>
                        </StackPanel.Resources>

                        <TextBlock Text="Blue Sapphire Toolkit" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="SYS.VERSION //" FontSize="10" Foreground="#555555" FontFamily="Consolas"/>

                        <TextBlock x:Name="VersionTextBlock" 
                                   Text="{x:Bind AppDisplayVersion, Mode=OneWay}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas, Courier New" 
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="VersionBrush" Color="White"/>
                            </TextBlock.Foreground>
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="VersionScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="{x:Bind AppBuildDate, Mode=OneWay}" Opacity="0.5" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"/>
                        <TextBlock Text="基于 WinUI 3 + Win2D 构建" Opacity="0.6" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>

                </Grid>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>