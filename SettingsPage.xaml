<Page
    x:Class="BlueSapphire.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40">
        <StackPanel Spacing="25" MaxWidth="750" HorizontalAlignment="Stretch">

            <TextBlock Text="系统设置" FontSize="32" FontWeight="Bold" Foreground="White" CharacterSpacing="80" Margin="0,0,0,5"/>

            <Rectangle Height="1" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#CC00FFFF" Offset="0"/>
                        <GradientStop Color="#0000FFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="25,20" CornerRadius="8">
                <Grid>
                    <TextBlock Text="神经网络粒子引擎" FontSize="18" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center" CharacterSpacing="25"/>

                    <ToggleSwitch x:Name="ParticleSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" IsOn="True" Margin="0,0,0,-6"/>
                </Grid>
            </Border>

            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="30" CornerRadius="8">

                <StackPanel Background="Transparent" 
                            PointerPressed="SecretVersion_PointerPressed"
                            PointerEntered="SecretVersion_PointerEntered"
                            PointerExited="SecretVersion_PointerExited" 
                            Spacing="15">

                    <StackPanel.Resources>
                        <Storyboard x:Name="VersionClickStoryboard">
                            <DoubleAnimation Storyboard.TargetName="VersionScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1.0" To="0.8" Duration="0:0:0.1" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="VersionScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             From="1.0" To="0.8" Duration="0:0:0.1" AutoReverse="True"/>
                            <ColorAnimation Storyboard.TargetName="VersionBrush"
                                            Storyboard.TargetProperty="Color"
                                            From="#00FFFF" To="White" Duration="0:0:0.1" AutoReverse="True"/>
                        </Storyboard>
                    </StackPanel.Resources>

                    <TextBlock Text="蓝宝石工具箱" FontSize="26" FontWeight="Bold" Foreground="White" CharacterSpacing="60"/>

                    <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">

                        <TextBlock x:Name="VersionTextBlock" 
                                   Text="{x:Bind AppDisplayVersion, Mode=OneWay}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   CharacterSpacing="20" 
                                   RenderTransformOrigin="0.5,0.5"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="VersionBrush" Color="#00FFFF"/>
                            </TextBlock.Foreground>
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="VersionScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock Text="|" Foreground="#30FFFFFF" FontSize="16" VerticalAlignment="Center" Margin="0,-2,0,0"/>

                        <TextBlock Text="{x:Bind AppBuildDate, Mode=OneWay}" Foreground="#80FFFFFF" FontSize="14" VerticalAlignment="Center" CharacterSpacing="10"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>