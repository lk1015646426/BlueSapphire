<ContentDialog
    x:Class="BlueSapphire.AudioTrimDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="音频裁剪"
    PrimaryButtonText="开始裁剪"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="14" Width="420">
        <Border Background="#10F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock x:Name="FileNameTextBlock" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DurationTextBlock" FontSize="12" Opacity="0.75"/>
                <TextBlock x:Name="ModeHintTextBlock" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="开始时间" FontWeight="SemiBold"/>
                <TextBox x:Name="StartTextBox"
                         PlaceholderText="例如 12.5 或 01:23"
                         TextChanged="TimeTextBox_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="结束时间" FontWeight="SemiBold"/>
                <TextBox x:Name="EndTextBox"
                         PlaceholderText="例如 45 或 02:34"
                         TextChanged="TimeTextBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="支持输入秒数、mm:ss 或 hh:mm:ss。" FontSize="12" Opacity="0.75"/>
        <TextBlock x:Name="RangeHintTextBlock" FontSize="12" Opacity="0.75"/>
        <TextBlock x:Name="ValidationTextBlock" Foreground="#FFFF6B6B" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</ContentDialog>
