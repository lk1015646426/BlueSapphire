<ContentDialog
    x:Class="BlueSapphire.DuplicateResultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlueSapphire.Models"
    Title="重复文件扫描结果"
    PrimaryButtonText="移至回收站"
    CloseButtonText="取消"
    DefaultButton="Close"
    PrimaryButtonStyle="{StaticResource DangerActionButtonStyle}"
    CloseButtonStyle="{StaticResource SubtleActionButtonStyle}"
    Style="{StaticResource WorkbenchContentDialogStyle}"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <CollectionViewSource x:Name="GroupedItems" IsSourceGrouped="True"/>

        <DataTemplate x:Key="DuplicateGroupHeaderTemplate" x:DataType="models:DuplicateGroup">
            <Border Background="{ThemeResource PanelSurfaceStrong}" Padding="10,7" Margin="0,8,0,0"
                    BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,0,0,1">
                <TextBlock Text="{x:Bind GroupTitle}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondary}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DuplicateItemTemplate" x:DataType="models:DuplicateItem">
            <Grid Padding="10,7" MinHeight="60" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                          Checked="DuplicateItem_SelectionChanged"
                          Unchecked="DuplicateItem_SelectionChanged"
                          AutomationProperties.Name="选择要移至回收站的文件"
                          VerticalAlignment="Center"/>
                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="6"
                        Background="{ThemeResource MediaSurface}" VerticalAlignment="Center">
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind DisplayName}" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind DateString}" Style="{StaticResource DialogHelperTextStyle}"/>
                    <TextBlock Text="建议保留，请人工确认" Visibility="{x:Bind SuggestionVisibility}"
                               Foreground="{ThemeResource AccentSafe}" FontSize="11"/>
                </StackPanel>
                <ToolTipService.ToolTip><ToolTip Content="{x:Bind PathString}"/></ToolTipService.ToolTip>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid x:Name="DuplicateDialogRoot"
          MaxWidth="720"
          MaxHeight="500"
          HorizontalAlignment="Stretch"
          RowSpacing="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveDialogStates">
                <VisualState x:Name="CompactDialog"/>
                <VisualState x:Name="WideDialog">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DuplicateList.MaxHeight" Value="420"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="GuidanceText" Style="{StaticResource DialogHelperTextStyle}"/>
        <Border Grid.Row="1" Background="{ThemeResource AccentReviewBg}" CornerRadius="6" Padding="10,8">
            <TextBlock Text="勾选的文件将进入回收站。双击图片可先用默认程序预览。"
                       Foreground="{ThemeResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource DialogSectionStyle}" Padding="0">
            <ListView x:Name="DuplicateList" SelectionMode="None" MaxHeight="340"
                      ItemsSource="{x:Bind GroupedItems.View, Mode=OneWay}"
                      ItemTemplate="{StaticResource DuplicateItemTemplate}"
                      ContainerContentChanging="DuplicateList_ContainerContentChanging"
                      DoubleTapped="DuplicateList_DoubleTapped"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource DuplicateGroupHeaderTemplate}"/>
                </ListView.GroupStyle>
            </ListView>
        </Border>
    </Grid>
</ContentDialog>

