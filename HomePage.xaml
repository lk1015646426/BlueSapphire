<Page
    x:Class="BlueSapphire.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="CoreIdleAnimation">

            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1.02" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1.02" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="CoreTranslate" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="PulseGlowBrush" Storyboard.TargetProperty="Opacity" From="0.1" To="0.5" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="OuterRingRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:1:0" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="InnerRingRotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:40" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="CoreCrystalRotate" Storyboard.TargetProperty="Angle" From="45" To="405" Duration="0:1:30" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentStack" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentTranslate" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid Background="#FF030308" Opacity="0.6" />

        <StackPanel x:Name="ContentStack" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ContentTranslate"/>
            </StackPanel.RenderTransform>

            <Grid Width="280" Height="280" Margin="0,0,0,50">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CoreScale" CenterX="140" CenterY="140" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="CoreTranslate" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Ellipse Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush x:Name="PulseGlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" Opacity="0.3">
                            <GradientStop Color="#00F0FF" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="220" Height="220" Stroke="#30FFFFFF" StrokeThickness="1" StrokeDashArray="1 4 8 4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="OuterRingRotate" CenterX="110" CenterY="110"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse Width="160" Height="160" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="InnerRingRotate" CenterX="80" CenterY="80"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8000FFFF" Offset="0"/>
                            <GradientStop Color="#10FFFFFF" Offset="0.3"/>
                            <GradientStop Color="#6000FFFF" Offset="0.7"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>

                <Grid Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="CoreCrystalRotate" Angle="45" CenterX="30" CenterY="30"/>
                    </Grid.RenderTransform>

                    <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1" Opacity="0.8">
                        <Rectangle.Stroke>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#2000FFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Stroke>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1500FFFF" Offset="0"/>
                                <GradientStop Color="#05FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle Width="42" Height="42" RadiusX="3" RadiusY="3" Stroke="#00FFFF" StrokeThickness="1.5" Opacity="0.6"/>
                    <Rectangle Width="26" Height="26" Stroke="#40FFFFFF" StrokeThickness="0.5" Opacity="0.4"/>
                </Grid>

                <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Fill="#FFFFFF" Opacity="0.9"/>
                    <Ellipse Fill="#00FFFF" Opacity="0.6">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2" CenterX="6" CenterY="6"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Grid>

            <TextBlock x:Name="GreetingText" 
                       Text="正在感知系统环境..." 
                       FontSize="22" 
                       FontWeight="Light" 
                       Foreground="#F0FFFFFF" 
                       HorizontalAlignment="Center" 
                       CharacterSpacing="60"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.25" Margin="0,35,0,0">
                <TextBlock Text="蓝宝石引擎" FontWeight="SemiBold" FontSize="11" CharacterSpacing="250" Margin="0,0,15,0"/>
                <TextBlock Text="|" FontSize="10" Margin="0,0,15,0" Foreground="#80FFFFFF"/>
                <TextBlock Text="核心运转平稳" FontSize="11" CharacterSpacing="250"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>