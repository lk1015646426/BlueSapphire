<Page
    x:Class="BlueSapphire.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="CoreIdleAnimation">

            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1.02" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1.02" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="CoreTranslate" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

        </Storyboard>

        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentStack" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentTranslate" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource BgColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ContentStack"
                  MaxWidth="1180"
                  Padding="40,32"
                  HorizontalAlignment="Center"
                  Opacity="0"
                  ColumnSpacing="24">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="20">
                    <Border Width="180"
                            Height="180"
                            HorizontalAlignment="Left"
                            CornerRadius="38"
                            BorderBrush="{StaticResource BorderActive}"
                            BorderThickness="1"
                            AutomationProperties.Name="蓝宝石工具箱品牌标志">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CoreScale" CenterX="90" CenterY="90"/>
                                <TranslateTransform x:Name="CoreTranslate"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Image Source="ms-appx:///BS.ico"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="蓝宝石工具箱" Style="{StaticResource TextStyle_PageTitle}"/>
                        <TextBlock x:Name="GreetingText"
                                   Text="正在读取工作状态…"
                                   FontSize="18"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="从这里进入常用工具，所有清理、下载和第三方扩展操作都会在执行前明确确认。"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="当前状态" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock x:Name="AIStatusText" Text="AI 服务：检测中" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="CleanerStatusText" Text="清理助手：读取中" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock x:Name="ReleaseStatusText" Text="版本：读取中" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <TextBlock Text="快速开始" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>

                    <Button Tag="AICopilotTool" Click="OpenTool_Click" Style="{StaticResource ActionButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="打开 AI 智能助手">
                        <Grid Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentCyanBg}">
                                <FontIcon Glyph="&#xE9D9;" Foreground="{StaticResource AccentCyan}" FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AI 智能助手" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/>
                                <TextBlock Text="对话分析、工具导航与经确认的自动操作" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE72A;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Tag="CleanerAssistant" Click="OpenTool_Click" Style="{StaticResource ActionButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="打开清理助手">
                        <Grid Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentSafeBg}">
                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AccentSafe}" FontSize="19"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="清理助手" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/>
                                <TextBlock Text="扫描、风险分级、隔离恢复与审计记录" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE72A;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Tag="MediaManager" Click="OpenTool_Click" Style="{StaticResource ActionButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="打开媒体管家">
                        <Grid Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentInspectBg}">
                                <FontIcon Glyph="&#xE8B9;" Foreground="{StaticResource AccentInspect}" FontSize="19"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="媒体管家" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/>
                                <TextBlock Text="图片搜索、标签、去重、批量编辑与自动增强" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE72A;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Tag="EvolutionLog" Click="OpenTool_Click" Style="{StaticResource ActionButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="打开更新日志">
                        <Grid Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentReviewBg}">
                                <FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource AccentReview}" FontSize="19"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="更新日志" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/>
                                <TextBlock Text="查看版本变化、修复记录和功能说明" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE72A;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
