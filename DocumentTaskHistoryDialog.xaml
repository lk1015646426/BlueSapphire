<ContentDialog
    x:Class="BlueSapphire.DocumentTaskHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlueSapphire.Models"
    Title="文档任务历史"
    PrimaryButtonText="打开结果"
    CloseButtonText="关闭"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <DataTemplate x:Key="HistoryItemTemplate" x:DataType="models:DocumentConversionBatchReport">
            <Grid Padding="10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="17" Background="#12222222" VerticalAlignment="Top">
                    <FontIcon Glyph="{x:Bind HistoryStatusGlyph}" Foreground="{x:Bind HistoryStatusBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind OperationName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind CreatedAtText}" Opacity="0.72" FontSize="12"/>
                    <TextBlock Text="{x:Bind SummaryText}" Opacity="0.85" FontSize="12" TextWrapping="WrapWholeWords"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind HistoryStatusText}" Foreground="{x:Bind HistoryStatusBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{x:Bind HistoryCountText}" Opacity="0.65" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <Border Background="#1200FFFF" BorderBrush="#3300FFFF" BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock Text="保留最近的文档任务记录。选择一项后可直接打开对应结果面板。" FontSize="12" Opacity="0.78" TextWrapping="WrapWholeWords"/>
        </Border>

        <ListView x:Name="HistoryList"
                  Width="560"
                  MaxHeight="520"
                  SelectionMode="Single"
                  ItemTemplate="{StaticResource HistoryItemTemplate}"
                  SelectionChanged="HistoryList_SelectionChanged"/>
    </StackPanel>
</ContentDialog>
