                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{x:Bind ViewModel.AudioPreviewPlayPauseGlyph, Mode=OneWay}" FontSize="12"/>
                                <TextBlock Text="{x:Bind ViewModel.AudioPreviewPlayPauseText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.SkipForwardAudioPreviewCommand}"
                                IsEnabled="{x:Bind ViewModel.CanControlAudioPreview, Mode=OneWay}"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <FontIcon Glyph="&#xE894;" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.NextAudioPreviewCommand}"
                                IsEnabled="{x:Bind ViewModel.CanGoToNextAudioPreview, Mode=OneWay}"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <FontIcon Glyph="&#xE895;" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.CycleAudioPreviewLoopModeCommand}"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{x:Bind ViewModel.AudioPreviewLoopModeText, Mode=OneWay}" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.AudioPreviewTitleText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.AudioPreviewSubtitleText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.AudioPreviewPositionText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            <Slider x:Name="AudioPreviewSlider"
                                    Grid.Column="1"
                                    Margin="0,-2"
                                    Minimum="0"
                                    Maximum="{x:Bind ViewModel.AudioPreviewSeekMaximum, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.AudioPreviewSeekValue, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanControlAudioPreview, Mode=OneWay}"
                                    PointerPressed="AudioPreviewSlider_PointerPressed"
                                    PointerReleased="AudioPreviewSlider_PointerReleased"
                                    PointerCaptureLost="AudioPreviewSlider_PointerCaptureLost"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AudioPreviewDurationText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="2" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="10" Padding="10,6" VerticalAlignment="Center" Background="#10F59E0B">
                        <StackPanel>
                            <TextBlock Text="AUDIO PREVIEW" Foreground="{StaticResource ColorAudio}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.AudioPreviewQueueText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Padding="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="25">
                    <TextBlock Text="OK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ColorAll}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TabStatusTextBlock" Text="{x:Bind ViewModel.TabStatusText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="ITEMS:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="CountTextBlock" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="PathTextBlock" Grid.Column="2" Text="{x:Bind ViewModel.PathText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
