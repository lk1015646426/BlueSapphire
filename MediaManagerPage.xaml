                                                Background="#14F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="999" Padding="6,2">
                                            <TextBlock Text="封面" Foreground="{StaticResource ColorAudio}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Visibility="{x:Bind HasAudioLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                                Background="#1400D28D" BorderBrush="#3300D28D" BorderThickness="1" CornerRadius="999" Padding="6,2">
                                            <TextBlock Text="歌词" Foreground="{StaticResource ColorAll}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Visibility="{x:Bind HasCustomTags, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                            Background="#1400D28D" BorderBrush="#3300D28D" BorderThickness="1" CornerRadius="999" Padding="6,2" Margin="0,4,0,0">
