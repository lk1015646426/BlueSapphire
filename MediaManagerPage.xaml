<Page
    x:Class="BlueSapphire.MediaManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    Loaded="MediaManagerPage_Loaded">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>

        <SolidColorBrush x:Key="PageBg" Color="#FF101418"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#FF151B22"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FF171E26"/>
        <SolidColorBrush x:Key="CardBg" Color="#FF1E2630"/>
        <SolidColorBrush x:Key="CardBgHover" Color="#FF25313D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334B5563"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFA7B0BD"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF20C878"/>
        <SolidColorBrush x:Key="AccentGreenBg" Color="#2220C878"/>
        <SolidColorBrush x:Key="AccentSky" Color="#FF38BDF8"/>
        <SolidColorBrush x:Key="AccentSkyBg" Color="#2238BDF8"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="AccentAmberBg" Color="#22F59E0B"/>
        <SolidColorBrush x:Key="AccentDanger" Color="#FFFB7185"/>
        <SolidColorBrush x:Key="AccentDangerBg" Color="#22FB7185"/>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModuleCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="136"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="FunctionCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="78"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="QuickListButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MEDIA MANAGER" FontSize="10" Foreground="{StaticResource TextMuted}" CharacterSpacing="100"/>
                <TextBlock Text="媒体管家" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,2,0,0"/>
            </StackPanel>

            <TextBox x:Name="FunctionSearchBox"
                     Grid.Column="1"
                     Width="320"
                     MinHeight="38"
                     Margin="16,0,12,0"
                     PlaceholderText="搜索功能"
                     TextChanged="FunctionSearchBox_TextChanged"
                     Visibility="{x:Bind ViewModel.IsImageWorkspaceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>

            <Button Grid.Column="2"
                    Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.ReturnToMediaHomeCommand}"
                    Visibility="{x:Bind ViewModel.IsImageWorkspaceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="模块" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid Visibility="{x:Bind ViewModel.IsModulePickerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <Grid Padding="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
                            <TextBlock Text="资产类型" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="选择工作台" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" MaxWidth="560" HorizontalAlignment="Left">
                            <Button Style="{StaticResource ModuleCardButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenImageWorkspaceCommand}">
                                <Grid Padding="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="58" Height="58" Background="{StaticResource AccentGreenBg}" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="27" Foreground="{StaticResource AccentGreen}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Text="图片" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Width="38" Height="38" Background="{StaticResource AccentGreenBg}" CornerRadius="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE76C;" FontSize="15" Foreground="{StaticResource AccentGreen}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{x:Bind ViewModel.IsImageWorkspaceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FunctionPanelRow" Height="*"/>
                    <RowDefinition x:Name="ImageGalleryRow" Height="0"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="FunctionScrollViewer"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled"
                              Background="{StaticResource PanelBg}">
                    <StackPanel Padding="24,14,24,22" Spacing="18">
                        <StackPanel x:Name="FunctionSectionsPanel" Spacing="18">
                            <Border x:Name="QuickSection" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ImportSourceCard" Grid.Column="0" Style="{StaticResource QuickListButtonStyle}" Command="{x:Bind ViewModel.OpenFolderCommand}" Tag="导入 图片源 文件夹 打开 image source folder">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="18,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{StaticResource AccentGreen}"/>
                                            <TextBlock Text="导入图片源" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0"/>

                                    <Button x:Name="SortCard" Grid.Column="1" Style="{StaticResource QuickListButtonStyle}" Click="OnSortCardClicked" Tag="排序 名称 日期 大小 升序 降序 sort">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="18,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8CB;" FontSize="20" Foreground="{StaticResource AccentSky}"/>
                                            <TextBlock Text="排序" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0"/>

                                    <Button x:Name="RenameCard" Grid.Column="2" Style="{StaticResource QuickListButtonStyle}" Command="{x:Bind ViewModel.RenameSelectedCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}" Tag="重命名 命名 时间 rename">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="18,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8AC;" FontSize="20" Foreground="{StaticResource AccentAmber}"/>
                                            <TextBlock Text="重命名" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="OrganizeSection" Spacing="10">
                                <TextBlock Text="整理" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="DuplicateCard" Grid.Column="0" Style="{StaticResource FunctionCardButtonStyle}" Click="OnDuplicateCardClicked" Tag="扫描 去重 重复 相似 duplicate scan">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="扫描去重" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="ProcessSection" Spacing="10">
                                <TextBlock Text="处理" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Button x:Name="FormatCard" Grid.Column="0" Style="{StaticResource FunctionCardButtonStyle}" Click="OnFormatCardClicked" Tag="格式 转换 jpg jpeg png bmp format convert">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE8B9;" FontSize="22" Foreground="{StaticResource AccentSky}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="格式转换" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ResizeCard" Grid.Column="1" Style="{StaticResource FunctionCardButtonStyle}" Click="OnResizeCardClicked" Tag="尺寸 调整 长边 1280 1920 2560 resize size">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE740;" FontSize="22" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="尺寸调整" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="CropCard" Grid.Column="2" Style="{StaticResource FunctionCardButtonStyle}" Click="OnCropCardClicked" Tag="裁剪 比例 1:1 4:3 16:9 crop">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE7A8;" FontSize="22" Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="裁剪" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="CompressCard" Grid.Column="3" Style="{StaticResource FunctionCardButtonStyle}" Click="OnCompressCardClicked" Tag="压缩 导出 轻度 均衡 高压缩 compress export">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{StaticResource AccentSky}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="压缩导出" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="EnhanceCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource FunctionCardButtonStyle}" Click="OnEnhanceCardClicked" Tag="AI 增强 智能 清晰 低光 enhance">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE945;" FontSize="22" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="AI 增强" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="ManageSection" Spacing="10">
                                <TextBlock Text="管理" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="OpenLocationCard" Grid.Column="0" Style="{StaticResource FunctionCardButtonStyle}" Command="{x:Bind ViewModel.OpenSelectedLocationCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}" Tag="打开位置 文件夹 资源管理器 location explorer">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE838;" FontSize="22" Foreground="{StaticResource AccentSky}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="打开位置" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="ResultCard" Grid.Column="1" Style="{StaticResource FunctionCardButtonStyle}" Command="{x:Bind ViewModel.ShowLastImageOperationResultsCommand}" IsEnabled="{x:Bind ViewModel.HasImageOperationResults, Mode=OneWay}" Tag="查看结果 结果 日志 result">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE9D5;" FontSize="22" Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="查看结果" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="TagCard" Grid.Column="2" Style="{StaticResource FunctionCardButtonStyle}" Command="{x:Bind ViewModel.EditSelectedMediaTagsCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}" Tag="标签 打标签 自定义 标签 tag">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE8EC;" FontSize="22" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="打标签" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="DeleteCard" Grid.Column="3" Style="{StaticResource FunctionCardButtonStyle}" Click="OnDeleteClicked" Tag="删除 回收站 delete recycle">
                                        <Grid Padding="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE74D;" FontSize="22" Foreground="{StaticResource AccentDanger}" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="1" Text="删除" Foreground="{StaticResource AccentDanger}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="NoFunctionResultPanel" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="8" Padding="0,16">
                            <FontIcon Glyph="&#xE721;" FontSize="26" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="没有匹配功能" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ImageGalleryPanel"
                      Grid.Row="1"
                      Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                    <GridView x:Name="ImageGrid"
                              ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                              SelectionMode="Multiple"
                              IsMultiSelectCheckBoxEnabled="True"
                              Padding="18"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ContainerContentChanging="ImageGrid_ContainerContentChanging"
                              DoubleTapped="ImageGrid_DoubleTapped">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:ImageItem">
                                <Border Width="180" Height="230" Margin="8" Background="{StaticResource CardBg}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#FF0C1116" CornerRadius="8,8,0,0">
                                            <Grid>
                                                <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC101418" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind MediaTypeLabel}" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#CC101418" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind FileExtensionLabel}" Foreground="{StaticResource TextMain}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1" Padding="10,8" Spacing="4">
                                            <TextBlock Text="{x:Bind FileName}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind DetailLineText}" Visibility="{x:Bind HasDetailLine, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind CustomTagSummaryText}" Visibility="{x:Bind HasCustomTags, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind MetadataPrimaryText}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{x:Bind MetadataSecondaryText}" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="46" Height="46" Foreground="{StaticResource AccentGreen}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMainText, Mode=OneWay}" FontSize="16" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                        <ProgressBar Width="320"
                                     Minimum="0"
                                     Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Padding="18,8"
              BorderBrush="{StaticResource BorderColor}"
              BorderThickness="0,1,0,0"
              Background="{StaticResource HeaderBg}"
              Visibility="{x:Bind ViewModel.IsImageWorkspaceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="OK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.TabStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="18,0,0,0">
                <TextBlock Text="ITEMS:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PathText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Page>
