                                                Background="#16F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="999" Padding="8,3">
                                            <TextBlock Text="{x:Bind MediaTypeLabel}" Foreground="{StaticResource ColorAudio}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Visibility="{x:Bind IsDocumentFile, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                                Background="{StaticResource ColorDocBg}" BorderBrush="{StaticResource ColorDoc}" BorderThickness="1" CornerRadius="999" Padding="8,3">
                                            <TextBlock Text="{x:Bind MediaTypeLabel}" Foreground="{StaticResource ColorDoc}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#A6080D10"
                                            BorderBrush="#1FFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="8,3">
                                        <TextBlock Text="{x:Bind FileExtensionLabel}" Foreground="{StaticResource TextMain}" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <Rectangle Fill="#30000000" Height="56" VerticalAlignment="Bottom" Margin="6,0,6,6" RadiusX="4" RadiusY="4"/>
                            </Grid>
