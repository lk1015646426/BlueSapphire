<Page
    x:Class="BlueSapphire.MediaManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    Background="{StaticResource BgColor}">

    <Page.Resources>
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextMain}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentInspect}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentInspect}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonAllStyle" TargetType="RadioButton" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextMain}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSafe}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSafe}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleActionButtonStyle}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        
        <Style x:Key="ChipButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentDanger}"/>
            <Setter Property="Background" Value="{StaticResource AccentDangerBg}"/>
        </Style>
        <Style x:Key="ChipButtonGreenStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style x:Key="ChipButtonSkyStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Padding="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="媒体管家" Style="{StaticResource TextStyle_PageTitle}"/>
                <TextBlock Text="集中整理、搜索和批量处理你的图片。" Foreground="{StaticResource TextMuted}" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <DropDownButton Style="{StaticResource PrimaryActionButtonStyle}">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE890;" FontSize="14"/>
                            <TextBlock Text="导入图片" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导入文件夹" Command="{x:Bind ViewModel.OpenFolderCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8D5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="导入单张/多张图片" Command="{x:Bind ViewModel.OpenFilesCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B9;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Search and filter area -->
        <Grid Grid.Row="1" Padding="24,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{StaticResource AccentInspect}"/>
                <TextBlock Text="图片库" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <AutoSuggestBox x:Name="MediaSearchBox"
                            Grid.Column="1"
                            MaxWidth="520"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="搜索文件名、路径、格式或自定义标签"
                            TextChanged="MediaSearchBox_TextChanged"
                            QueryIcon="Find"
                            AutomationProperties.Name="搜索图片"/>
            <ComboBox x:Name="TagFilterCombo"
                      Grid.Column="2"
                      SelectedIndex="0"
                      SelectionChanged="TagFilterCombo_SelectionChanged"
                      AutomationProperties.Name="标签筛选">
                <ComboBoxItem Content="全部图片" Tag="All"/>
                <ComboBoxItem Content="有标签" Tag="Tagged"/>
                <ComboBoxItem Content="无标签" Tag="Untagged"/>
            </ComboBox>
        </Grid>

        <!-- 分层工具栏：第一行整理图片库，第二行只处理当前选择 -->
        <Grid Grid.Row="2"
              Padding="24,10,24,14"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="图片库" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <DropDownButton Style="{StaticResource ChipButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="名称升序" Tag="NameAsc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="名称降序" Tag="NameDesc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="日期升序" Tag="DateAsc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="日期降序" Tag="DateDesc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="大小升序" Tag="SizeAsc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="大小降序" Tag="SizeDesc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.SortButtonText, Mode=OneWay}" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton>
                    
                    <DropDownButton Style="{StaticResource ChipButtonGreenStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="精确扫描" Tag="Exact" Click="OnDuplicateFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="智能扫描" Tag="Similar" Click="OnDuplicateFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12"/>
                            <TextBlock Text="扫描去重" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton>

                    <Button Style="{StaticResource ChipButtonStyle}"
                            Command="{x:Bind ViewModel.ShowLastImageOperationResultsCommand}"
                            Visibility="{x:Bind ViewModel.HasImageOperationResults, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="12"/>
                            <TextBlock Text="上次结果" FontSize="13"/>
                        </StackPanel>
                    </Button>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelSurfaceStrong}"
                    CornerRadius="12"
                    Padding="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="所选图片" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0"/>

                    <Button x:Name="RenameButton" IsEnabled="False" Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.RenameSelectedCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8AC;" FontSize="12"/>
                            <TextBlock Text="重命名" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <DropDownButton x:Name="EditDropDown" IsEnabled="False" Style="{StaticResource ChipButtonSkyStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Text="格式转换" Command="{x:Bind ViewModel.OpenFormatConvertDialogCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="高级图片编辑 (裁切/缩放/压缩)" Command="{x:Bind ViewModel.OpenAdvancedEditorDialogCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="12"/>
                            <TextBlock Text="编辑功能" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton>

                    <Button x:Name="EnhanceButton" IsEnabled="False" Style="{StaticResource ChipButtonSkyStyle}" ToolTipService.ToolTip="自动增强" Command="{x:Bind ViewModel.OpenEnhanceDialogCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12"/>
                            <TextBlock Text="自动增强" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="TagButton" IsEnabled="False" Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.EditSelectedMediaTagsCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                            <TextBlock Text="标签" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenLocationButton" IsEnabled="False" Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.OpenSelectedLocationCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="12"/>
                            <TextBlock Text="打开位置" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteButton" IsEnabled="False" Style="{StaticResource ChipButtonDangerStyle}" Click="OnDeleteClicked" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            <TextBlock Text="删除" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Empty State -->
        <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Border Width="64" Height="64" Background="{StaticResource AccentInspectBg}" BorderThickness="0" CornerRadius="16" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="28" Foreground="{StaticResource AccentInspect}"/>
                </Border>
                <TextBlock Text="还没有导入图片" FontSize="18" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="选择一个图片文件夹，或直接导入多张图片开始整理。" FontSize="13" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                <Button Command="{x:Bind ViewModel.OpenFolderCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D5;" FontSize="14"/>
                        <TextBlock Text="导入图片文件夹"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.HasNoFilterResults, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE721;" FontSize="30" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="没有符合当前搜索或标签筛选的图片" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="清空搜索内容或切换为“全部图片”即可恢复列表。" Foreground="{StaticResource TextMuted}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Gallery -->
        <Grid x:Name="ImageGalleryPanel"
              Grid.Row="3"
              Visibility="{x:Bind ViewModel.HasVisibleImages, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <GridView x:Name="ImageGrid"
                      ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                      SelectionMode="Multiple"
                      IsMultiSelectCheckBoxEnabled="True"
                      Padding="24,18"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ContainerContentChanging="ImageGrid_ContainerContentChanging"
                      SelectionChanged="ImageGrid_SelectionChanged"
                      DoubleTapped="ImageGrid_DoubleTapped">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ImageItem">
                        <Border Width="180" Height="230" Margin="8" Background="{StaticResource PanelSurface}" CornerRadius="12" BorderThickness="0">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="打开文件位置" Tag="{x:Bind}" Click="ContextOpenLocation_Click"/>
                                    <MenuFlyoutItem Text="编辑自定义标签" Tag="{x:Bind}" Click="ContextEditTags_Click"/>
                                    <MenuFlyoutItem Text="自动增强" Tag="{x:Bind}" Click="ContextEnhance_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="移至回收站" Tag="{x:Bind}" Click="ContextDelete_Click"/>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{StaticResource MediaSurface}" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="{StaticResource BadgeSurface}" CornerRadius="8" Padding="7,3">
                                            <TextBlock Text="{x:Bind MediaTypeLabel}" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{StaticResource BadgeSurface}" CornerRadius="8" Padding="7,3">
                                            <TextBlock Text="{x:Bind FileExtensionLabel}" Foreground="{StaticResource TextMain}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Padding="10,8" Spacing="4">
                                    <TextBlock Text="{x:Bind FileName}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DetailLineText}" Visibility="{x:Bind HasDetailLine, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind CustomTagSummaryText}" Visibility="{x:Bind HasCustomTags, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentSafe}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind MetadataPrimaryText}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind MetadataSecondaryText}" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border x:Name="SelectionDetailsPanel"
                    Grid.Column="1"
                    Width="250"
                    Margin="0,18,20,18"
                    Padding="14"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelSurfaceStrong}"
                    BorderThickness="0"
                    CornerRadius="12"
                    DataContext="{Binding SelectedItem, ElementName=ImageGrid}">
                <StackPanel Spacing="10">
                    <TextBlock Text="所选图片" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <Image Source="{Binding ImageSource}" Height="150" Stretch="Uniform" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DetailLineText}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MetadataPrimaryText}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding MetadataSecondaryText}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding CustomTagSummaryText}" Foreground="{StaticResource AccentInspect}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ImagePath}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" MaxHeight="56"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="4"
              Padding="18,8"
              BorderBrush="{StaticResource BorderColor}"
              BorderThickness="0,1,0,0"
              Background="{StaticResource PanelSurfaceStrong}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="就绪" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentSafe}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.TabStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="18,0,0,0">
                <TextBlock Text="项目：" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PathText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- App-wide Busy Indicator Overlay -->
        <Grid Grid.RowSpan="5" 
              Background="{StaticResource OverlayScrim}"
              Canvas.ZIndex="100"
              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="52" Height="52" Foreground="{StaticResource AccentCyan}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMainText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Opacity="0.8"/>
                <ProgressBar Width="400"
                             Margin="0,10,0,0"
                             Minimum="0"
                             Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}"
                             Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                <Button Content="取消操作"
                        Command="{x:Bind ViewModel.CancelOperationCommand}"
                        Style="{StaticResource SubtleActionButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanCancelOperation, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
