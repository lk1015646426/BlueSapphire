<Page
    x:Class="BlueSapphire.MediaManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>

        <SolidColorBrush x:Key="BgColor" Color="#080D10"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#0B141A"/>
        <SolidColorBrush x:Key="PanelSurfaceStrong" Color="#101A22"/>
        <SolidColorBrush x:Key="PanelStroke" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="PanelHighlight" Color="#10FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <SolidColorBrush x:Key="ColorAll" Color="#00D28D"/>
        <SolidColorBrush x:Key="ColorAllBg" Color="#1A00D28D"/>
        <SolidColorBrush x:Key="ColorImage" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="ColorImageBg" Color="#140EA5E9"/>
        <SolidColorBrush x:Key="ColorAudio" Color="#F59E0B"/>
        <SolidColorBrush x:Key="ColorDoc" Color="#EAB308"/>
        <SolidColorBrush x:Key="ColorDocBg" Color="#1AEAB308"/>

        <SolidColorBrush x:Key="ColorDanger" Color="#EF4444"/>
        <SolidColorBrush x:Key="ColorDangerBg" Color="#1AEF4444"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelHighlight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>

        <Style x:Key="ToolbarDropDownButtonStyle" TargetType="DropDownButton">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelHighlight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="25,15" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="MEDIA MANAGER" FontSize="10" Foreground="{StaticResource TextMuted}" CharacterSpacing="100"/>
                <TextBlock Text="媒体管家" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" CharacterSpacing="20" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="ImportPathButton"
                        Command="{x:Bind ViewModel.OpenFolderByPathCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="Transparent"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" Foreground="{StaticResource TextMain}" FontSize="14"/>
                        <TextBlock Text="输入路径" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ImportSourceButton" Command="{x:Bind ViewModel.OpenFolderCommand}" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="{StaticResource ColorAllBg}" BorderBrush="{StaticResource ColorAll}" 
                        BorderThickness="1" CornerRadius="6" Padding="15,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" Foreground="{StaticResource ColorAll}" FontSize="14"/>
                        <TextBlock Text="导入数据源" Foreground="{StaticResource ColorAll}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="TabsContainer" Grid.Row="1" Orientation="Horizontal" Padding="25,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Spacing="30">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Border x:Name="TabAll" Tapped="Tab_Tapped" Tag="All" Background="Transparent" BorderBrush="{StaticResource ColorAll}" BorderThickness="0,0,0,2" Padding="0,15">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81E;" Foreground="{StaticResource ColorAll}" FontSize="14"/>
                    <TextBlock Text="全部文件" Foreground="{StaticResource ColorAll}" FontSize="14"/>
                </StackPanel>
            </Border>

            <Border x:Name="TabImage" Tapped="Tab_Tapped" Tag="Image" Background="Transparent" BorderThickness="0,0,0,2" Padding="0,15" Opacity="0.5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B9;" Foreground="{StaticResource TextMain}" FontSize="14"/>
                    <TextBlock Text="图片" Foreground="{StaticResource TextMain}" FontSize="14"/>
                </StackPanel>
            </Border>

            <Border x:Name="TabAudio" Tapped="Tab_Tapped" Tag="Audio" Background="Transparent" BorderThickness="0,0,0,2" Padding="0,15" Opacity="0.5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource TextMain}" FontSize="14"/>
                    <TextBlock Text="音频" Foreground="{StaticResource TextMain}" FontSize="14"/>
                </StackPanel>
            </Border>

            <Border x:Name="TabDoc" Tapped="Tab_Tapped" Tag="Doc" Background="Transparent" BorderThickness="0,0,0,2" Padding="0,15" Opacity="0.5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" Foreground="{StaticResource TextMain}" FontSize="14"/>
                    <TextBlock Text="文档" Foreground="{StaticResource TextMain}" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Padding="25,15" MinHeight="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelSurface}"
                    BorderBrush="{StaticResource PanelStroke}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10">
            <ScrollViewer HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled"
                          IsHorizontalRailEnabled="True">
            <StackPanel x:Name="ActionToolbar" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                        <AddDeleteThemeTransition />
                        <EntranceThemeTransition FromHorizontalOffset="18" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <DropDownButton Style="{StaticResource ToolbarDropDownButtonStyle}">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="12"/>
                            <TextBlock Text="{x:Bind GetSortButtonText(ViewModel.CurrentSortField), Mode=OneWay}" FontSize="13" VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE0E3;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="按名称" Command="{x:Bind ViewModel.ChangeSortCommand}" CommandParameter="Name"/>
                            <MenuFlyoutItem Text="按日期" Command="{x:Bind ViewModel.ChangeSortCommand}" CommandParameter="Date"/>
                            <MenuFlyoutItem Text="按大小" Command="{x:Bind ViewModel.ChangeSortCommand}" CommandParameter="Size"/>

                            <MenuFlyoutSeparator Background="{StaticResource BorderColor}"/>

                            <MenuFlyoutItem Text="切换 升序/降序" Command="{x:Bind ViewModel.ToggleSortDirectionCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CB;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Border Width="1" Background="{StaticResource BorderColor}" Margin="5,0"/>

                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{x:Bind ViewModel.RenameSelectedCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AC;" FontSize="12"/>
                        <TextBlock Text="重命名" FontSize="13"/>
                    </StackPanel>
                </Button>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeDoc, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                Background="{StaticResource ColorAllBg}" BorderBrush="{StaticResource ColorAll}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74C;" Foreground="{StaticResource ColorAll}" FontSize="12"/>
                            <TextBlock Text="扫描去重" Foreground="{StaticResource ColorAll}" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="精确扫描" Command="{x:Bind ViewModel.ScanDuplicatesCommand}" CommandParameter="Exact">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B0;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="智能扫描" Command="{x:Bind ViewModel.ScanDuplicatesCommand}" CommandParameter="Similar">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE824;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeImage, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="常规图片格式转换"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorImage}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D5;" FontSize="12"/>
                            <TextBlock Text="格式转换" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="转 JPEG" Tag="Jpeg" Click="OnImageFormatConvertClicked"/>
                            <MenuFlyoutItem Text="转 PNG" Tag="Png" Click="OnImageFormatConvertClicked"/>
                            <MenuFlyoutItem Text="转 BMP" Tag="Bmp" Click="OnImageFormatConvertClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeImage, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="按长边快速调整图片尺寸"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorImage}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7C8;" FontSize="12"/>
                            <TextBlock Text="尺寸调整" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="长边 1280" Tag="LongEdge1280" Click="OnImageResizeClicked"/>
                            <MenuFlyoutItem Text="长边 1920" Tag="LongEdge1920" Click="OnImageResizeClicked"/>
                            <MenuFlyoutItem Text="长边 2560" Tag="LongEdge2560" Click="OnImageResizeClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeImage, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="按常用比例进行中心裁剪"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorImage}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A8;" FontSize="12"/>
                            <TextBlock Text="裁剪" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="1:1 中心裁剪" Tag="Square" Click="OnImageCropClicked"/>
                            <MenuFlyoutItem Text="4:3 中心裁剪" Tag="Ratio4x3" Click="OnImageCropClicked"/>
                            <MenuFlyoutItem Text="16:9 中心裁剪" Tag="Ratio16x9" Click="OnImageCropClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeImage, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="导出更小的 JPEG 文件"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorImage}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                            <TextBlock Text="压缩导出" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="轻度压缩" Tag="Light" Click="OnImageCompressClicked"/>
                            <MenuFlyoutItem Text="均衡压缩" Tag="Balanced" Click="OnImageCompressClicked"/>
                            <MenuFlyoutItem Text="高压缩" Tag="Aggressive" Click="OnImageCompressClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeImage, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="智能增强、清晰增强和低光优化"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorImage}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12"/>
                            <TextBlock Text="AI 增强" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="智能增强" Tag="SmartFix" Click="OnImageEnhanceClicked"/>
                            <MenuFlyoutItem Text="清晰增强" Tag="DetailBoost" Click="OnImageEnhanceClicked"/>
                            <MenuFlyoutItem Text="低光优化" Tag="LowLight" Click="OnImageEnhanceClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="常规音频格式转换"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D5;" FontSize="12"/>
                            <TextBlock Text="格式转换" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="转 MP3" Tag="Mp3" Click="OnAudioFormatConvertClicked"/>
                            <MenuFlyoutItem Text="转 WAV" Tag="Wav" Click="OnAudioFormatConvertClicked"/>
                            <MenuFlyoutItem Text="转 M4A" Tag="M4a" Click="OnAudioFormatConvertClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="按音频元数据自动生成规范文件名"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8AC;" FontSize="12"/>
                            <TextBlock Text="元数据重命名" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="按标题" Tag="Title" Click="OnAudioMetadataRenameClicked"/>
                            <MenuFlyoutItem Text="按艺术家 - 标题" Tag="ArtistTitle" Click="OnAudioMetadataRenameClicked"/>
                            <MenuFlyoutItem Text="按曲序 - 标题" Tag="TrackTitle" Click="OnAudioMetadataRenameClicked"/>
                            <MenuFlyoutItem Text="按专辑 - 曲序 - 标题" Tag="AlbumTrackTitle" Click="OnAudioMetadataRenameClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="按当前文件名规则写入标题、艺术家、专辑和曲序等标签"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D4;" FontSize="12"/>
                            <TextBlock Text="文件名写标签" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="标题" Tag="Title" Click="OnAudioFilenameImportClicked"/>
                            <MenuFlyoutItem Text="艺术家 - 标题" Tag="ArtistTitle" Click="OnAudioFilenameImportClicked"/>
                            <MenuFlyoutItem Text="曲序 - 标题" Tag="TrackTitle" Click="OnAudioFilenameImportClicked"/>
                            <MenuFlyoutItem Text="专辑 - 曲序 - 标题" Tag="AlbumTrackTitle" Click="OnAudioFilenameImportClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.EditSelectedAudioTagsCommand}"
                        CommandParameter="{x:Bind ImageGrid.SelectedItems, Mode=OneWay}"
                        ToolTipService.ToolTip="编辑选中音频的标题、艺术家、专辑、专辑艺术家、流派、作曲、曲序、碟序、年份、备注和歌词"
                        Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        <TextBlock Text="编辑标签" FontSize="13"/>
                    </StackPanel>
                </Button>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="为音频写入、导入、清除或导出内嵌封面"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE91B;" FontSize="12"/>
                            <TextBlock Text="封面" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="设置封面" Click="OnAudioCoverApplyClicked"/>
                            <MenuFlyoutItem Text="从同名图片导入" Click="OnAudioCoverImportSidecarClicked"/>
                            <MenuFlyoutItem Text="清除封面" Click="OnAudioCoverClearClicked"/>
                            <MenuFlyoutItem Text="导出封面" Click="OnAudioCoverExportClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <DropDownButton Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                Style="{StaticResource ToolbarDropDownButtonStyle}"
                                ToolTipService.ToolTip="导入或导出音频歌词"
                                Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                            <TextBlock Text="歌词" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="从歌词文件导入" Click="OnAudioLyricsImportClicked"/>
                            <MenuFlyoutItem Text="从同名歌词导入" Click="OnAudioLyricsImportSidecarClicked"/>
                            <MenuFlyoutItem Text="导出歌词" Click="OnAudioLyricsExportClicked"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.ExportSelectedAudioCatalogCommand}"
                        CommandParameter="{x:Bind ImageGrid.SelectedItems, Mode=OneWay}"
                        ToolTipService.ToolTip="将选中音频的元数据导出为 CSV 清单"
                        Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="12"/>
                        <TextBlock Text="导出清单" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.ImportSelectedAudioCatalogCommand}"
                        CommandParameter="{x:Bind ImageGrid.SelectedItems, Mode=OneWay}"
                        ToolTipService.ToolTip="从 CSV 清单批量写回音频标签；空白值将清空对应字段"
                        Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="12"/>
                        <TextBlock Text="导入清单" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Visibility="{x:Bind ViewModel.IsTypeAudio, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Bind ViewModel.TrimSelectedAudioCommand}"
                        CommandParameter="{x:Bind ImageGrid.SelectedItems, Mode=OneWay}"
                        ToolTipService.ToolTip="裁剪当前选中的单个音频，导出一个新的片段文件"
                        Background="Transparent" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource ColorAudio}" BorderThickness="1" CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C1;" FontSize="12"/>
                        <TextBlock Text="裁剪" FontSize="13"/>
                    </StackPanel>
                </Button>

