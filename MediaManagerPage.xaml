<Page
    x:Class="BlueSapphire.MediaManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    Loaded="MediaManagerPage_Loaded">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>

        <SolidColorBrush x:Key="PageBg" Color="#FF101418"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#FF151B22"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FF171E26"/>
        <SolidColorBrush x:Key="CardBg" Color="#FF1E2630"/>
        <SolidColorBrush x:Key="CardBgHover" Color="#FF25313D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334B5563"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFA7B0BD"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF20C878"/>
        <SolidColorBrush x:Key="AccentGreenBg" Color="#2220C878"/>
        <SolidColorBrush x:Key="AccentSky" Color="#FF38BDF8"/>
        <SolidColorBrush x:Key="AccentSkyBg" Color="#2238BDF8"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="AccentAmberBg" Color="#22F59E0B"/>
        <SolidColorBrush x:Key="AccentDanger" Color="#FFFB7185"/>
        <SolidColorBrush x:Key="AccentDangerBg" Color="#22FB7185"/>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextMain}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSky}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSky}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonAllStyle" TargetType="RadioButton" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextMain}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentGreen}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentGreen}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Background" Value="{StaticResource AccentGreenBg}"/>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        
        <Style x:Key="ChipButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentDanger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDanger}"/>
        </Style>
        <Style x:Key="ChipButtonGreenStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
        </Style>
        <Style x:Key="ChipButtonSkyStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentSky}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Padding="24,16,24,12" Background="{StaticResource HeaderBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MEDIA MANAGER" FontSize="10" Foreground="{StaticResource TextMuted}" CharacterSpacing="100"/>
                <TextBlock Text="媒体管家" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <DropDownButton Style="{StaticResource PrimaryActionButtonStyle}">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE890;" FontSize="14"/>
                            <TextBlock Text="导入数据源" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导入文件夹" Command="{x:Bind ViewModel.OpenFolderCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8D5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="导入单张/多张图片" Command="{x:Bind ViewModel.OpenFilesCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B9;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Tabs Area -->
        <Grid Grid.Row="1" Padding="24,0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButtonStyle}" GroupName="MainTabs" IsChecked="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                        <TextBlock Text="图片"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- Chip Toolbar -->
        <Grid Grid.Row="2" Padding="24,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" IsDeferredScrollingEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <DropDownButton Style="{StaticResource ChipButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="名称升序" Tag="NameAsc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="名称降序" Tag="NameDesc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="日期升序" Tag="DateAsc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="日期降序" Tag="DateDesc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="大小升序" Tag="SizeAsc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="大小降序" Tag="SizeDesc" Click="OnSortFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.SortButtonText, Mode=OneWay}" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton>
                    
                    <Button Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.RenameSelectedCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8AC;" FontSize="12"/>
                            <TextBlock Text="重命名" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <DropDownButton Style="{StaticResource ChipButtonGreenStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="精确扫描" Tag="Exact" Click="OnDuplicateFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="智能扫描" Tag="Similar" Click="OnDuplicateFlyoutItemClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12"/>
                            <TextBlock Text="扫描去重" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton>

                    <DropDownButton Style="{StaticResource ChipButtonSkyStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Text="格式转换" Command="{x:Bind ViewModel.OpenFormatConvertDialogCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="高级图片编辑 (裁切/缩放/压缩)" Command="{x:Bind ViewModel.OpenAdvancedEditorDialogCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="12"/>
                            <TextBlock Text="编辑功能" FontSize="13"/>
                        </StackPanel>
                    </DropDownButton>

                    <Button Style="{StaticResource ChipButtonSkyStyle}" ToolTipService.ToolTip="AI 增强" Command="{x:Bind ViewModel.OpenEnhanceDialogCommand}" CommandParameter="{x:Bind ImageGrid.SelectedItems}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12"/>
                            <TextBlock Text="AI 增强" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource ChipButtonDangerStyle}" Click="OnDeleteClicked" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            <TextBlock Text="删除" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Empty State -->
        <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Border Width="72" Height="72" Background="Transparent" BorderBrush="{StaticResource AccentSky}" BorderThickness="2" CornerRadius="16" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="32" Foreground="{StaticResource AccentSky}"/>
                </Border>
                <TextBlock Text="等待接入图片媒体库..." FontSize="16" Foreground="{StaticResource AccentSky}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="点击右上角「导入数据源」开始。" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Gallery -->
        <Grid x:Name="ImageGalleryPanel"
              Grid.Row="3"
              Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <GridView x:Name="ImageGrid"
                      ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                      SelectionMode="Multiple"
                      IsMultiSelectCheckBoxEnabled="True"
                      Padding="24,18"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ContainerContentChanging="ImageGrid_ContainerContentChanging"
                      DoubleTapped="ImageGrid_DoubleTapped">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ImageItem">
                        <Border Width="180" Height="230" Margin="8" Background="{StaticResource CardBg}" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#FF0C1116" CornerRadius="8,8,0,0">
                                    <Grid>
                                        <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC101418" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind MediaTypeLabel}" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#CC101418" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind FileExtensionLabel}" Foreground="{StaticResource TextMain}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Padding="10,8" Spacing="4">
                                    <TextBlock Text="{x:Bind FileName}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DetailLineText}" Visibility="{x:Bind HasDetailLine, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind CustomTagSummaryText}" Visibility="{x:Bind HasCustomTags, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind MetadataPrimaryText}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind MetadataSecondaryText}" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="4"
              Padding="18,8"
              BorderBrush="{StaticResource BorderColor}"
              BorderThickness="0,1,0,0"
              Background="{StaticResource HeaderBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="OK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.TabStatusText}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="18,0,0,0">
                <TextBlock Text="ITEMS:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PathText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- App-wide Busy Indicator Overlay -->
        <Grid Grid.RowSpan="5" 
              Background="#D90C1116" 
              Canvas.ZIndex="100"
              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="60" Height="60" Foreground="{StaticResource AccentGreen}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMainText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Opacity="0.8"/>
                <ProgressBar Width="400"
                             Margin="0,10,0,0"
                             Minimum="0"
                             Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}"
                             Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                <Button Content="取消操作"
                        Command="{x:Bind ViewModel.CancelOperationCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
