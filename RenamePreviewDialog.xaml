<ContentDialog
    x:Class="BlueSapphire.RenamePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlueSapphire.Models"
    Title="批量重命名预览"
    PrimaryButtonText="确认修改"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource PrimaryActionButtonStyle}"
    CloseButtonStyle="{StaticResource SubtleActionButtonStyle}"
    Style="{StaticResource WorkbenchContentDialogStyle}"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <DataTemplate x:Key="RenameItemTemplate" x:DataType="models:RenamePreviewItem">
            <Grid Padding="10,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind OriginalName}" Foreground="{ThemeResource TextMuted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12"
                          Foreground="{ThemeResource TextFaint}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind NewName}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid x:Name="RenameDialogRoot"
          MaxWidth="680"
          MaxHeight="500"
          HorizontalAlignment="Stretch"
          RowSpacing="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveDialogStates">
                <VisualState x:Name="CompactDialog"/>
                <VisualState x:Name="WideDialog">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PreviewList.MaxHeight" Value="360"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="确认原名称与新名称；只有点击“确认修改”后才会写入文件。"
                   Style="{StaticResource DialogHelperTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionStyle}" Padding="0">
            <ListView x:Name="PreviewList" SelectionMode="None" MaxHeight="320"
                      ItemTemplate="{StaticResource RenameItemTemplate}"/>
        </Border>

        <Border Grid.Row="2" Background="{ThemeResource AccentReviewBg}" CornerRadius="6"
                Padding="10,8" Visibility="{Binding Visibility, ElementName=WarningText}">
            <TextBlock x:Name="WarningText" Foreground="{ThemeResource AccentReview}"
                       FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Border>

        <TextBlock Grid.Row="3" Text="命名格式：年-月-日_时-分-秒；重名时自动添加序号。"
                   Style="{StaticResource DialogHelperTextStyle}"/>
    </Grid>
</ContentDialog>
