<ContentDialog
    x:Class="BlueSapphire.RenamePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    Title="批量重命名预览"
    PrimaryButtonText="确认修改"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource PrimaryActionButtonStyle}"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <DataTemplate x:Key="RenameItemTemplate" x:DataType="models:RenamePreviewItem">
            <Grid Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind OriginalName}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" Grid.Column="1" Margin="10,0" Opacity="0.5"/>
                <TextBlock Text="{x:Bind NewName}" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <TextBlock Text="请确认以下更改：" FontWeight="SemiBold"/>

        <ListView x:Name="PreviewList" 
                  SelectionMode="None" 
                  MaxHeight="400"
                  ItemTemplate="{StaticResource RenameItemTemplate}"/>

        <TextBlock x:Name="WarningText" 
                   Foreground="{StaticResource AccentReview}"
                   FontSize="12" 
                   TextWrapping="Wrap" 
                   Visibility="Collapsed"/>

        <TextBlock Text="命名格式：yyyy-MM-dd_HH-mm-ss（仅有日期时为 yyyy-MM-dd；冲突时自动添加序号）"
                   Opacity="0.6" 
                   FontSize="12"/>
    </StackPanel>
</ContentDialog>
