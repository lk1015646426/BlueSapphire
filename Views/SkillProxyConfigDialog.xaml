<ContentDialog
    x:Class="BlueSapphire.Views.SkillProxyConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择连接方式"
    Style="{StaticResource WorkbenchContentDialogStyle}">

    <Grid Width="440" MaxWidth="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SubtitleText" Text="选择该在线技能的连接方式"
                   Style="{StaticResource DialogHelperTextStyle}"/>

        <Button Grid.Row="1" Style="{StaticResource DialogChoiceButtonStyle}"
                BorderBrush="{ThemeResource AccentSafe}" Click="Domestic_Click"
                AutomationProperties.Name="使用国内直连">
            <Grid Padding="14,12" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE909;" Foreground="{ThemeResource AccentSafe}" FontSize="16" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="国内直连（推荐）" FontWeight="SemiBold" Foreground="{ThemeResource AccentSafe}"/>
                    <TextBlock Text="绕过全局代理，适用于国内服务器，可避免代理拦截。"
                               Style="{StaticResource DialogHelperTextStyle}"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button Grid.Row="2" Style="{StaticResource DialogChoiceButtonStyle}"
                Click="SystemProxy_Click" AutomationProperties.Name="跟随系统网络设置">
            <Grid Padding="14,12" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource TextSecondary}" FontSize="16" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="跟随系统" FontWeight="SemiBold"/>
                    <TextBlock Text="使用 Windows 当前网络和代理设置。无法确定时选择此项。"
                               Style="{StaticResource DialogHelperTextStyle}"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button Grid.Row="3" Content="取消" HorizontalAlignment="Right"
                Style="{StaticResource SubtleActionButtonStyle}" Click="Cancel_Click"/>
    </Grid>
</ContentDialog>
