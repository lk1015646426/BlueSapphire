<Page
    x:Class="BlueSapphire.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    Background="{ThemeResource BgColor}">

    <Grid x:Name="LayoutRoot" Padding="{StaticResource WorkbenchPagePadding}" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TaskColumn.Width" Value="*"/>
                        <Setter Target="ActivityColumn.Width" Value="0"/>
                        <Setter Target="RecentActivityCard.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TaskColumn.Width" Value="1.25*"/>
                        <Setter Target="ActivityColumn.Width" Value="0.75*"/>
                        <Setter Target="RecentActivityCard.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowHeightStates">
                <VisualState x:Name="ShortHomeLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AiRow.Height" Value="0.9*"/>
                        <Setter Target="TaskRow.Height" Value="1.1*"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TallHomeLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="780"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AiRow.Height" Value="1.15*"/>
                        <Setter Target="TaskRow.Height" Value="0.85*"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="AiRow" Height="*"/>
            <RowDefinition x:Name="TaskRow" Height="*"/>
        </Grid.RowDefinitions>

        <Frame x:Name="AiFrame"
               Background="Transparent"
               IsNavigationStackEnabled="False"/>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TaskColumn" Width="1.25*"/>
                <ColumnDefinition x:Name="ActivityColumn" Width="0.75*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{ThemeResource PanelSurface}"
                            BorderBrush="{ThemeResource BorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Padding="12,9" Spacing="2">
                                <TextBlock Text="任务" Style="{StaticResource TextStyle_Caption}"/>
                                <TextBlock Text="{Binding TotalTaskCountText}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{ThemeResource BorderSubtle}"
                                    BorderThickness="1,0" Padding="12,9">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="进行中" Style="{StaticResource TextStyle_Caption}"/>
                                    <TextBlock Text="{Binding ActiveTaskCountText}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Padding="12,9" Spacing="2">
                                <TextBlock Text="服务" Style="{StaticResource TextStyle_Caption}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentSafe}"/>
                                    <TextBlock Text="本地可用" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Padding="12,8,10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="继续你的工作" FontSize="14" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="打开清理工具"
                                Style="{StaticResource WorkbenchTextButtonStyle}"
                                Click="Cleaner_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5"
                                    Visibility="{Binding EmptyVisibility}">
                            <TextBlock Text="没有待处理任务" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="从 AI 对话、媒体工作台或清理工具开始。"
                                       Style="{StaticResource TextStyle_Caption}"/>
                        </StackPanel>

                        <ListView ItemsSource="{Binding TaskPreview}"
                                  Visibility="{Binding TaskListVisibility}"
                                  SelectionMode="None" BorderThickness="0" Padding="0,0,0,6">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,0,0,1">
                                        <Grid Padding="12,9" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextStyle_Caption}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{ThemeResource AccentReview}"/>
                                                <Button Content="查看" Tag="{Binding Kind}"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        Click="TaskOpen_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="RecentActivityCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最近活动" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="实时" Style="{StaticResource TextStyle_Caption}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5"
                                Visibility="{Binding EmptyVisibility}">
                        <TextBlock Text="暂无活动" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="任务状态变化会显示在这里。" Style="{StaticResource TextStyle_Caption}"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ActivityPreview}"
                                  Visibility="{Binding TaskListVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <Grid Padding="0,9" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UpdatedAtText}" FontSize="10"
                                                   Foreground="{ThemeResource TextFaint}"/>
                                        <Ellipse Grid.Column="1" Width="6" Height="6"
                                                 Fill="{ThemeResource AccentPrimary}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextStyle_Caption}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <Button Content="媒体工作台" Style="{StaticResource CompactButtonStyle}" Click="Media_Click"/>
                        <Button Content="清理工具" Style="{StaticResource CompactButtonStyle}" Click="Cleaner_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
