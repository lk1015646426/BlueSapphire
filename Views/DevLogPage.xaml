<Page
    x:Class="BlueSapphire.Views.DevLogPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    Background="#050505">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter" />

        <SolidColorBrush x:Key="CyberNeonCyan" Color="#FF00FFFF" />
        <SolidColorBrush x:Key="CyberDimCyan" Color="#3300FFFF" />
        <SolidColorBrush x:Key="CyberTextDim" Color="#AAFFFFFF" />
        <FontFamily x:Key="CyberFont">Microsoft YaHei, PingFang SC, sans-serif</FontFamily>
    </Page.Resources>

    <Grid>
        <Grid Padding="30,20" x:Name="MainContentGrid" MaxWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BackButton_Click" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" Padding="8,4" ToolTipService.ToolTip="返回控制中枢/设置">
                    <SymbolIcon Symbol="Back" Foreground="{StaticResource CyberTextDim}"/>
                </Button>

                <TextBlock Grid.Column="1" Text="开发日志与版本记录" FontFamily="{StaticResource CyberFont}" Foreground="{StaticResource CyberNeonCyan}" FontSize="20" FontWeight="Bold" CharacterSpacing="5" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="添加记录" Click="OpenInputDialog_Click" 
                        Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        Background="#2200FFFF" Foreground="{StaticResource CyberNeonCyan}" BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1" FontFamily="{StaticResource CyberFont}" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,20">
                <Rectangle Height="1" Fill="{StaticResource CyberDimCyan}" HorizontalAlignment="Stretch"/>
                <Rectangle Width="60" Height="2" Fill="{StaticResource CyberNeonCyan}" HorizontalAlignment="Left"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,28,0,0"
                    Padding="12,8"
                    Background="#121A1A1A"
                    BorderBrush="#2200FFFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.IsReadOnlyMode, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <TextBlock Text="当前为只读模式：安装版仅展示版本记录，新增和删除操作仅在开发/调试环境开放。"
                           Foreground="{StaticResource CyberTextDim}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource CyberFont}"/>
            </Border>

            <ListView Grid.Row="2" 
                      ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ShowsScrollingPlaceholders="False">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DevLogItem">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Rectangle Width="2" Fill="{x:Bind CardBorderBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,20,0,-12"/>
                                <Ellipse Width="16" Height="16" Fill="{x:Bind CardBackgroundBrush, Mode=OneWay}" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                <Ellipse Width="8" Height="8" Fill="{x:Bind VersionGlowBrush, Mode=OneWay}" VerticalAlignment="Top" Margin="0,16,0,0"/>
                            </Grid>

                            <Border Grid.Column="1" Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1" Padding="15,12" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                        <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind VersionGlowBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="2" Padding="4,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind VersionTypeTag, Mode=OneWay}" FontSize="9" Foreground="{x:Bind VersionGlowBrush, Mode=OneWay}" FontWeight="Bold" FontFamily="Consolas"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="White" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource CyberFont}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
                                        <TextBlock Text="{x:Bind Version, Mode=OneWay}" Foreground="{x:Bind VersionGlowBrush, Mode=OneWay}" FontSize="18" FontWeight="Black" FontFamily="{StaticResource CyberFont}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind DisplayTime, Mode=OneWay}" Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind Description, Mode=OneWay}" Foreground="{StaticResource CyberTextDim}" FontSize="13" LineHeight="20" TextWrapping="Wrap" FontFamily="{StaticResource CyberFont}"/>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="15">

                                        <Button Content="编辑" CommandParameter="{x:Bind}"
                                                Click="EditLog_Click"
                                                Visibility="{Binding ElementName=RootPage, Path=ViewModel.IsEditable, Converter={StaticResource BoolToVisibleConverter}}"
                                                Background="#101E90FF" Foreground="#7FDBFF" BorderBrush="#303FA9F5" BorderThickness="1" CornerRadius="4" Padding="8,4" FontSize="12" FontFamily="{StaticResource CyberFont}"/>

                                        <Button Content="删除" CommandParameter="{x:Bind}" 
                                                Click="DeleteLog_Click" 
                                                Visibility="{Binding ElementName=RootPage, Path=ViewModel.IsEditable, Converter={StaticResource BoolToVisibleConverter}}"
                                                Background="#10FF0000" Foreground="#FF4444" BorderBrush="#30FF0000" BorderThickness="1" CornerRadius="4" Padding="8,4" FontSize="12" FontFamily="{StaticResource CyberFont}"/>

                                        <Button Content="阅读文档" CommandParameter="{x:Bind}" 
                                                Click="OpenDetail_Click" 
                                                PointerEntered="OpenDetail_PointerEntered" 
                                                PointerExited="OpenDetail_PointerExited"
                                                Background="#1000FFFF" Foreground="{StaticResource CyberNeonCyan}" BorderBrush="#3000FFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" FontSize="12" FontFamily="{StaticResource CyberFont}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="DetailOverlay" Visibility="Collapsed" Background="#F2080808">
            <Grid Padding="40" MaxWidth="800">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20" BorderBrush="#3300FFFF" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource CyberFont}"/>
                        <TextBlock x:Name="DetailVersion" Foreground="{StaticResource CyberNeonCyan}" FontSize="14" Margin="0,5,0,0" FontFamily="{StaticResource CyberFont}"/>
                    </StackPanel>
                    <Button Content="关闭" Click="CloseDetail_Click" Background="#22FF0000" Foreground="#FF4444" BorderBrush="#FF0000" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="15,6" FontFamily="{StaticResource CyberFont}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Background="#0A0A0A" BorderBrush="#1100FFFF" BorderThickness="1" Padding="25">
                    <TextBlock x:Name="DetailContent" Foreground="#D0D0D0" FontSize="14" LineHeight="24" FontFamily="Consolas, Microsoft YaHei" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
