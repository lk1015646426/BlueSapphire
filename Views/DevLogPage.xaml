<Page
    x:Class="BlueSapphire.Views.DevLogPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlueSapphire.Models"
    Background="#050505">

    <Page.Resources>
        <SolidColorBrush x:Key="CyberNeonCyan" Color="#FF00FFFF" />
        <SolidColorBrush x:Key="CyberDimCyan" Color="#3300FFFF" />
        <SolidColorBrush x:Key="CyberCardBg" Color="#1100FFFF" />
        <SolidColorBrush x:Key="CyberTextDim" Color="#AAFFFFFF" />
        <FontFamily x:Key="CyberFont">Microsoft YaHei, PingFang SC, sans-serif</FontFamily>
    </Page.Resources>

    <Grid>
        <Grid Padding="40" x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="开发日志与版本记录" FontFamily="{StaticResource CyberFont}" Foreground="{StaticResource CyberNeonCyan}" FontSize="24" FontWeight="Bold" CharacterSpacing="5" />
                <Button Grid.Column="1" Content="添加记录" Click="OpenInputDialog_Click" Background="#2200FFFF" Foreground="{StaticResource CyberNeonCyan}" BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1" FontFamily="{StaticResource CyberFont}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,30">
                <Rectangle Height="1" Fill="{StaticResource CyberDimCyan}" HorizontalAlignment="Stretch"/>
                <Rectangle Width="100" Height="3" Fill="{StaticResource CyberNeonCyan}" HorizontalAlignment="Left"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DevLogItem">
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Rectangle Width="2" Fill="{StaticResource CyberDimCyan}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,30,0,-25"/>
                                    <Ellipse Width="24" Height="24" Fill="#1A00FFFF" VerticalAlignment="Top" Margin="0,18,0,0"/>
                                    <Ellipse Width="12" Height="12" Fill="{StaticResource CyberNeonCyan}" VerticalAlignment="Top" Margin="0,24,0,0"/>
                                </Grid>

                                <Border Grid.Column="1" Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberDimCyan}" BorderThickness="1" Padding="25" CornerRadius="4" Margin="0,0,20,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind Title, Mode=OneWay}" Foreground="White" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource CyberFont}" Margin="0,0,0,15"/>

                                        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="版本号：" Foreground="{StaticResource CyberTextDim}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,5,4"/>
                                                <TextBlock Text="{x:Bind Version, Mode=OneWay}" Foreground="{StaticResource CyberNeonCyan}" FontSize="26" FontWeight="Black" FontFamily="{StaticResource CyberFont}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind DisplayTime, Mode=OneWay}" Foreground="DimGray" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind Description, Mode=OneWay}" Foreground="{StaticResource CyberTextDim}" FontSize="14" LineHeight="24" TextWrapping="Wrap" FontFamily="{StaticResource CyberFont}"/>

                                        <Button Grid.Row="2" Grid.Column="1" Content="阅读完整文档" CommandParameter="{x:Bind}" 
                                                Click="OpenDetail_Click" 
                                                PointerEntered="OpenDetail_PointerEntered" 
                                                PointerExited="OpenDetail_PointerExited"
                                                Background="Transparent" Foreground="{StaticResource CyberNeonCyan}" BorderThickness="0" FontFamily="{StaticResource CyberFont}" Margin="0,15,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailOverlay" Visibility="Collapsed" Background="#F2080808">
            <Grid Padding="40" MaxWidth="1000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20" BorderBrush="#3300FFFF" BorderThickness="0,0,0,1" Padding="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Foreground="White" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource CyberFont}"/>
                        <TextBlock x:Name="DetailVersion" Foreground="{StaticResource CyberNeonCyan}" FontSize="16" Margin="0,5,0,0" FontFamily="{StaticResource CyberFont}"/>
                    </StackPanel>
                    <Button Content="关闭" Click="CloseDetail_Click" Background="#22FF0000" Foreground="#FF4444" BorderBrush="#FF0000" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{StaticResource CyberFont}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Background="#0A0A0A" BorderBrush="#1100FFFF" BorderThickness="1" Padding="30">
                    <TextBlock x:Name="DetailContent" Foreground="#D0D0D0" FontSize="14" LineHeight="26" FontFamily="Consolas, Microsoft YaHei" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>