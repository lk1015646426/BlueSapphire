<Page
    x:Class="BlueSapphire.Views.DevLogPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    Background="{ThemeResource BgColor}">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter" />

        <FontFamily x:Key="AppContentFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    </Page.Resources>

    <Grid>
        <Grid Padding="20" x:Name="MainContentGrid" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <Button Click="BackButton_Click"
                            Style="{StaticResource SubtleActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            AutomationProperties.Name="返回设置">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72B;" FontSize="13"/>
                            <TextBlock Text="返回设置"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="更新日志" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="版本变化、修复和使用说明" Foreground="{ThemeResource TextMuted}" FontSize="11"/>
                </StackPanel>

                <Button Grid.Column="1" Content="添加记录" Click="OpenInputDialog_Click"
                        Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                        Style="{StaticResource CompactButtonStyle}"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,10,0,10"
                    Padding="12,8"
                    Background="{StaticResource PanelSurfaceStrong}"
                    BorderThickness="0"
                    CornerRadius="10"
                    Visibility="{x:Bind ViewModel.IsReadOnlyMode, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <TextBlock Text="当前为只读模式：安装版仅展示版本记录，新增和删除操作仅在开发/调试环境开放。"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI, Microsoft YaHei"/>
            </Border>

            <ListView Grid.Row="2" 
                      ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ShowsScrollingPlaceholders="False">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DevLogItem">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Rectangle Width="2" Fill="{x:Bind CardBorderBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,20,0,-12"/>
                                <Ellipse Width="16" Height="16" Fill="{x:Bind CardBackgroundBrush, Mode=OneWay}" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                <Ellipse Width="8" Height="8" Fill="{x:Bind VersionGlowBrush, Mode=OneWay}" VerticalAlignment="Top" Margin="0,16,0,0"/>
                            </Grid>

                            <Border Grid.Column="1" Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderThickness="0" Padding="14,12" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                        <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}" BorderBrush="{x:Bind VersionGlowBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="7" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind VersionTypeTag, Mode=OneWay}" FontSize="10" Foreground="{x:Bind VersionGlowBrush, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource AppContentFont}"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppContentFont}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
                                        <TextBlock Text="{x:Bind Version, Mode=OneWay}" Foreground="{x:Bind VersionGlowBrush, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource AppContentFont}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind DisplayTime, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind Description, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" LineHeight="18" TextWrapping="Wrap" FontFamily="{StaticResource AppContentFont}"/>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="15">

                                        <Button Content="编辑" CommandParameter="{x:Bind}"
                                                Click="EditLog_Click"
                                                Visibility="{Binding ElementName=RootPage, Path=ViewModel.IsEditable, Converter={StaticResource BoolToVisibleConverter}}"
                                                Style="{StaticResource CompactButtonStyle}"/>

                                        <Button Content="删除" CommandParameter="{x:Bind}" 
                                                Click="DeleteLog_Click" 
                                                Visibility="{Binding ElementName=RootPage, Path=ViewModel.IsEditable, Converter={StaticResource BoolToVisibleConverter}}"
                                                Style="{StaticResource DangerActionButtonStyle}"/>

                                        <Button Content="阅读文档" CommandParameter="{x:Bind}" 
                                                Click="OpenDetail_Click" 
                                                PointerEntered="OpenDetail_PointerEntered" 
                                                PointerExited="OpenDetail_PointerExited"
                                                Style="{StaticResource CompactButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="DetailOverlay" Visibility="Collapsed" Background="{ThemeResource OverlayScrim}">
            <Grid Padding="24" MaxWidth="800">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20" BorderBrush="{StaticResource AccentPrimaryBg}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource AppContentFont}"/>
                        <TextBlock x:Name="DetailVersion" Foreground="{StaticResource AccentPrimary}" FontSize="14" Margin="0,5,0,0" FontFamily="{StaticResource AppContentFont}"/>
                    </StackPanel>
                    <Button Content="关闭" Click="CloseDetail_Click" Style="{StaticResource SubtleActionButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource PanelSurface}" CornerRadius="8" Padding="18">
                    <ScrollViewer>
                        <TextBlock x:Name="DetailContent" Foreground="{StaticResource TextMain}" FontSize="14" LineHeight="24" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
