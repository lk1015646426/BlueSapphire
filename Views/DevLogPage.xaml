<Page
    x:Class="BlueSapphire.Views.DevLogPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BlueSapphire.Models"
    xmlns:local="using:BlueSapphire"
    mc:Ignorable="d"
    Background="#0A0A0A">

    <Page.Resources>
        <SolidColorBrush x:Key="CyberNeonCyan" Color="#FF00FFCC" />
        <SolidColorBrush x:Key="CyberDarkGray" Color="#FF1E1E1E" />
        <FontFamily x:Key="TerminalFont">Consolas, Cascadia Code, Microsoft YaHei, Courier New</FontFamily>
        <local:StatusToColorConverter x:Key="StatusColorConverter"/>
    </Page.Resources>

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="[ 开发者矩阵 :: 进化跃迁记录 ]" 
                       FontFamily="{StaticResource TerminalFont}" 
                       Foreground="{StaticResource CyberNeonCyan}" 
                       FontSize="20" FontWeight="Bold" CharacterSpacing="50" />
            <TextBlock Text="警告：检测到系统底层覆写。仅限高级授权人员操作。" 
                       FontFamily="{StaticResource TerminalFont}" 
                       Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20" Padding="15" Background="{StaticResource CyberDarkGray}" CornerRadius="4" BorderBrush="#333" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="系统同步率 (SYNC_RATE)" Foreground="Gray" FontFamily="{StaticResource TerminalFont}" FontSize="10"/>
                <TextBlock Text="{x:Bind ViewModel.CompletionRate, Mode=OneWay}" Foreground="{StaticResource CyberNeonCyan}" FontSize="24" FontFamily="{StaticResource TerminalFont}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="已攻克节点 (NODES_CLEARED)" Foreground="Gray" FontFamily="{StaticResource TerminalFont}" FontSize="10"/>
                <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" Foreground="White" FontSize="24" FontFamily="{StaticResource TerminalFont}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="总异常任务 (TOTAL_ANOMALIES)" Foreground="Gray" FontFamily="{StaticResource TerminalFont}" FontSize="10"/>
                <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" Foreground="White" FontSize="24" FontFamily="{StaticResource TerminalFont}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DevLogItem">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Rectangle Width="2" Fill="#333" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,20,0,-20"/>
                                <Ellipse Width="14" Height="14" 
                                         Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusColorConverter}}" 
                                         Stroke="#0A0A0A" StrokeThickness="3" 
                                         VerticalAlignment="Top" Margin="0,5,0,0"/>
                            </Grid>

                            <Border Grid.Column="1" Background="#111" BorderBrush="#222" BorderThickness="1" Padding="16" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="White" FontSize="16" FontFamily="{StaticResource TerminalFont}"/>
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" Foreground="DimGray" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <TextBlock Text="{x:Bind DisplayTime, Mode=OneWay}" Foreground="#555" FontSize="10" FontFamily="{StaticResource TerminalFont}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Version, Mode=OneWay}" Foreground="#666" FontFamily="{StaticResource TerminalFont}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <Button Content="推进状态" 
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.AdvanceStatusCommand}"
                                                CommandParameter="{x:Bind}"
                                                Background="Transparent" BorderBrush="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusColorConverter}}" 
                                                Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusColorConverter}}"
                                                BorderThickness="1" FontFamily="{StaticResource TerminalFont}" Margin="0,0,10,0"/>
                                        <Button Content="删除" 
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteLogCommand}"
                                                CommandParameter="{x:Bind}"
                                                FontFamily="{StaticResource TerminalFont}" Background="Transparent" Foreground="DarkRed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="> 载入新节点数据 (INITIALIZE_NEW_NODE)_" 
                Click="OpenInputDialog_Click"
                HorizontalAlignment="Stretch" Padding="12" Margin="0,15,0,0"
                Background="{StaticResource CyberNeonCyan}" Foreground="Black" 
                FontFamily="{StaticResource TerminalFont}" FontWeight="Bold"/>
    </Grid>
</Page>