<Page
    x:Class="BlueSapphire.Views.DevLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BlueSapphire.Models"
    mc:Ignorable="d"
    Background="#0A0A0A">
    <Page.Resources>
        <SolidColorBrush x:Key="CyberNeonCyan" Color="#00FFCC" />
        <SolidColorBrush x:Key="CyberDarkGray" Color="#1E1E1E" />
        <FontFamily x:Key="TerminalFont">Consolas, Cascadia Code, Courier New</FontFamily>
    </Page.Resources>

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="[ DEV_MATRIX :: EVOLUTION_LOG ]" 
                       FontFamily="{StaticResource TerminalFont}" 
                       Foreground="{StaticResource CyberNeonCyan}" 
                       FontSize="20" FontWeight="Bold" CharacterSpacing="50" />
            <TextBlock Text="SYSTEM OVERRIDE DETECTED. AUTHORIZED ACCESS ONLY." 
                       FontFamily="{StaticResource TerminalFont}" 
                       Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <ListView Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DevLogItem">
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text=">>" Foreground="{StaticResource CyberNeonCyan}" 
                                   FontFamily="{StaticResource TerminalFont}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="16" FontFamily="{StaticResource TerminalFont}"/>
                            <TextBlock Text="{x:Bind Timestamp.ToString('yyyy-MM-dd HH:mm:ss')}" Foreground="DimGray" FontSize="12" FontFamily="{StaticResource TerminalFont}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Version}" Foreground="{StaticResource CyberNeonCyan}" 
                                       FontFamily="{StaticResource TerminalFont}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <Button Content="DEL" 
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteLogCommand}"
                                    CommandParameter="{x:Bind}"
                                    FontFamily="{StaticResource TerminalFont}" Background="Transparent" Foreground="DarkRed" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Background="{StaticResource CyberDarkGray}" Padding="16" CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ROOT@BLUE_SAPPHIRE:~$" Foreground="LimeGreen" 
                       FontFamily="{StaticResource TerminalFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewLogTitle, Mode=TwoWay}" 
                     PlaceholderText="INPUT NEW MILESTONE..." 
                     FontFamily="{StaticResource TerminalFont}"
                     BorderThickness="0" Background="Transparent" Foreground="White"
                     VerticalAlignment="Center">
                <TextBox.InputScope>
                    <InputScope>
                        <InputScopeName NameValue="Default"/>
                    </InputScope>
                </TextBox.InputScope>
            </TextBox>
            <Button Grid.Column="1" HorizontalAlignment="Right" Content="EXECUTE" 
                    Command="{x:Bind ViewModel.AddLogCommand}"
                    Background="{StaticResource CyberNeonCyan}" Foreground="Black" 
                    FontFamily="{StaticResource TerminalFont}" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Page>