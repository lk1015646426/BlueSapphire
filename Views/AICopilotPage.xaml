<Page
    x:Class="BlueSapphire.Views.AICopilotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40,20,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="智能助理" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="由 DeepSeek 强力驱动，支持自然语言控制与审计日志分析。" Foreground="#80FFFFFF" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border HorizontalAlignment="{Binding Alignment}" 
                                        Background="{Binding BackgroundBrush}" 
                                        CornerRadius="8" 
                                        Padding="15,10"
                                        MaxWidth="600">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White" LineHeight="22"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox" 
                     PlaceholderText="输入指令，例如：帮我清理一下系统垃圾..." 
                     Height="45" 
                     VerticalContentAlignment="Center" 
                     KeyDown="InputBox_KeyDown"/>
            
            <Button x:Name="SendBtn" 
                    Content="发送" 
                    Grid.Column="1" 
                    Margin="10,0,0,0" 
                    Height="45" 
                    Width="80" 
                    Style="{ThemeResource AccentButtonStyle}" 
                    Click="SendBtn_Click"/>
        </Grid>
    </Grid>
</Page>
