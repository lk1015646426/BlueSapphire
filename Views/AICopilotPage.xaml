<Page
    x:Class="BlueSapphire.Views.AICopilotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BlueSapphire.ViewModels"
    xmlns:helpers="using:BlueSapphire.Helpers"
    mc:Ignorable="d">

    <Grid Padding="40,20,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="智能助理" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="由 DeepSeek 强力驱动，支持自然语言控制与系统管家功能。" Foreground="#80FFFFFF" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionStatusIndicator" Width="8" Height="8" Fill="#60FFFFFF" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionStatusText" Text="连接状态检测中..." FontSize="12" Foreground="#80FFFFFF"/>
            </StackPanel>
        </StackPanel>

        <!-- 聊天记录显示区 -->
        <Border Grid.Row="1" Background="#05FFFFFF" BorderBrush="#11FFFFFF" BorderThickness="1" CornerRadius="12" Padding="15">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatList">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,12" HorizontalAlignment="{Binding Alignment}" MaxWidth="800">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- AI Avatar -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                        Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        VerticalAlignment="Top" Margin="0,0,12,0"
                                        Visibility="{Binding AIVisibility}">
                                    <FontIcon Glyph="{Binding AvatarGlyph}" FontSize="16" Foreground="#4DB8FF"/>
                                </Border>

                                <!-- Message Bubble -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding HeaderText}" FontSize="12" Foreground="#80FFFFFF" Margin="4,0,0,4"
                                               HorizontalAlignment="{Binding Alignment}"/>
                                    <Border Grid.Row="1" Background="{Binding BubbleBackground}" 
                                            CornerRadius="12" 
                                            Padding="16,12"
                                            BorderThickness="1"
                                            BorderBrush="{Binding BubbleBorder}">
                                        <Grid>
                                        <!-- User Message (Plain Text) -->
                                        <TextBlock Text="{Binding Content}" 
                                                   TextWrapping="Wrap" 
                                                   Foreground="#F5FFFFFF" 
                                                   LineHeight="24" 
                                                   FontSize="14" 
                                                   IsTextSelectionEnabled="True"
                                                   Visibility="{Binding UserVisibility}"/>
                                        
                                        <!-- AI Message (Markdown) -->
                                        <RichTextBlock helpers:MarkdownHelper.Markdown="{Binding Content}"
                                                                    Foreground="#E5E5E5" 
                                                                    FontSize="14"
                                                                    Visibility="{Binding AIVisibility}"/>
                                        
                                        <!-- Tool / System Message -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding ToolVisibility}" VerticalAlignment="Center">
                                            <ProgressRing IsActive="True" Width="14" Height="14" Foreground="#4DB8FF" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Content}" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="#A0FFFFFF" 
                                                       FontSize="13" 
                                                       FontStyle="Italic"/>
                                        </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- User Avatar -->
                                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="18" 
                                        Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        VerticalAlignment="Top" Margin="12,0,0,0"
                                        Visibility="{Binding UserVisibility}">
                                    <FontIcon Glyph="{Binding AvatarGlyph}" FontSize="16" Foreground="#FFB900"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 底部输入区 -->
        <Grid Grid.Row="2" Margin="0,20,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox" 
                     PlaceholderText="输入你的需求，例如：帮我清理一下系统垃圾..." 
                     MinHeight="48" 
                     MaxHeight="120"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     CornerRadius="12"
                     Background="#0AFFFFFF"
                     BorderBrush="#22FFFFFF"
                     VerticalContentAlignment="Center" 
                     Padding="16,0,16,0"
                     FontSize="14"
                     KeyDown="InputBox_KeyDown"/>
            
            <Button x:Name="SendBtn" 
                    Grid.Column="1" 
                    Height="48" 
                    Width="48" 
                    CornerRadius="12"
                    Style="{ThemeResource AccentButtonStyle}" 
                    Click="SendBtn_Click"
                    ToolTipService.ToolTip="发送消息">
                <!-- 纸飞机发送图标 -->
                <FontIcon Glyph="&#xE122;" FontSize="18"/>
            </Button>
        </Grid>
    </Grid>
</Page>
