<ContentDialog
    x:Class="BlueSapphire.Views.DevLogInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PanelSurface}"
    BorderBrush="{StaticResource AccentCyan}"
    BorderThickness="1"
    CornerRadius="4"
    PrimaryButtonText="确认保存"
    CloseButtonText="取消"
    DefaultButton="Close"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonStyle="{StaticResource PrimaryActionButtonStyle}">

    <ContentDialog.Resources>
        <FontFamily x:Key="CyberFont">Microsoft YaHei, PingFang SC, sans-serif</FontFamily>
    </ContentDialog.Resources>

    <StackPanel Spacing="15" Width="500">
        <TextBlock x:Name="DialogTitleText" Text="添加更新记录" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource CyberFont}"/>
        <Rectangle Height="1" Fill="{StaticResource AccentCyanBg}" HorizontalAlignment="Stretch" Margin="0,-5,0,5"/>

        <TextBox x:Name="TitleInput" Header="更新标题" PlaceholderText="例如：视觉重构与系统级优化" FontFamily="{StaticResource CyberFont}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="VersionInput" Grid.Column="0" Header="构建版本" PlaceholderText="1.0.0" FontFamily="{StaticResource CyberFont}"/>

            <ComboBox x:Name="LevelInput" Grid.Column="2" Header="记录分级" SelectedIndex="1" HorizontalAlignment="Stretch" FontFamily="{StaticResource CyberFont}">
                <ComboBoxItem Content="核心跃迁"/>
                <ComboBoxItem Content="常规迭代"/>
            </ComboBox>

            <TextBox x:Name="DateInput" Grid.Column="4" Header="更新日期(留空为当前)" PlaceholderText="年-月-日" FontFamily="{StaticResource CyberFont}"/>
        </Grid>

        <TextBox x:Name="DescInput" Header="版本摘要" PlaceholderText="请简要描述本次更新的核心业务变动..." Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource CyberFont}"/>

        <StackPanel Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="完整技术文档 (支持文本文件导入)" Foreground="{StaticResource TextMuted}" FontSize="12" FontFamily="{StaticResource CyberFont}"/>
            <Button Content="选择本地文档" Click="SelectTxtFile_Click" Background="{StaticResource AccentCyanBg}" Foreground="{StaticResource AccentCyan}" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1" HorizontalAlignment="Stretch" FontFamily="{StaticResource CyberFont}"/>
            <TextBlock x:Name="FileStatusText" Text="尚未选择文件" Foreground="{StaticResource TextFaint}" FontSize="12"/>
            <TextBox x:Name="FullContentInput"
                     Header="完整文档正文"
                     PlaceholderText="可直接输入完整版本说明，或先导入 txt / md 文件后再继续编辑。"
                     Height="220"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontFamily="{StaticResource CyberFont}"/>
        </StackPanel>

    </StackPanel>
</ContentDialog>
