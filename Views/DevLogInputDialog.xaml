<ContentDialog
    x:Class="BlueSapphire.Views.DevLogInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#151515"
    BorderBrush="#00FFFF"
    BorderThickness="1"
    CornerRadius="4"
    RequestedTheme="Dark"
    PrimaryButtonText="确认添加"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}">

    <ContentDialog.Resources>
        <FontFamily x:Key="CyberFont">Microsoft YaHei, PingFang SC, sans-serif</FontFamily>
    </ContentDialog.Resources>

    <StackPanel Spacing="15" Width="450">
        <TextBlock Text="添加版本更新记录" Foreground="#00FFFF" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource CyberFont}"/>
        <Rectangle Height="1" Fill="#3300FFFF" HorizontalAlignment="Stretch" Margin="0,-5,0,5"/>

        <TextBox x:Name="TitleInput" Header="更新标题" PlaceholderText="例如：视觉重构与零GC渲染" FontFamily="{StaticResource CyberFont}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="VersionInput" Grid.Column="0" Header="版本号" PlaceholderText="例如：v0.7.0" FontFamily="{StaticResource CyberFont}"/>
            <TextBox x:Name="DateInput" Grid.Column="2" Header="更新日期 (留空为当前)" PlaceholderText="yyyy-MM-dd" FontFamily="{StaticResource CyberFont}"/>
        </Grid>

        <TextBox x:Name="DescInput" Header="版本摘要" PlaceholderText="简要描述本次更新的核心内容，用于列表展示..." Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource CyberFont}"/>

        <StackPanel Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="完整文档内容 (支持 TXT 导入)" Foreground="Gray" FontSize="12" FontFamily="{StaticResource CyberFont}"/>
            <Button Content="选择本地 TXT 文件" Click="SelectTxtFile_Click" Background="#2200FFFF" Foreground="#00FFFF" BorderBrush="#00FFFF" BorderThickness="1" HorizontalAlignment="Stretch" FontFamily="{StaticResource CyberFont}"/>
            <TextBlock x:Name="FileStatusText" Text="未选择文件" Foreground="DimGray" FontSize="12" FontStyle="Italic"/>
        </StackPanel>

    </StackPanel>
</ContentDialog>