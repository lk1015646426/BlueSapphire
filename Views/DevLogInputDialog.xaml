<ContentDialog
    x:Class="BlueSapphire.Views.DevLogInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="注入数据 (EXECUTE)"
    CloseButtonText="放弃操作 (ABORT)"
    DefaultButton="Primary"
    Background="#151515"
    BorderBrush="#00FFCC"
    BorderThickness="1"
    CornerRadius="8">

    <ContentDialog.Resources>
        <FontFamily x:Key="TerminalFont">Consolas, Cascadia Code, Microsoft YaHei, Courier New</FontFamily>
    </ContentDialog.Resources>

    <StackPanel Spacing="15" Width="400">
        <TextBlock Text="ROOT@BLUE_SAPPHIRE:~/创建新节点$" Foreground="LimeGreen" FontFamily="{StaticResource TerminalFont}" FontSize="14"/>

        <TextBox x:Name="TitleInput" Header=">> 目标节点标题" 
                 PlaceholderText="例如：实现底层粒子物理碰撞" 
                 FontFamily="{StaticResource TerminalFont}" Background="Transparent" Foreground="White"/>

        <TextBox x:Name="DescInput" Header=">> 异常/任务详细描述" 
                 PlaceholderText="在这里记录修复细节或开发灵感..." 
                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                 FontFamily="{StaticResource TerminalFont}" Background="Transparent" Foreground="White"/>

        <TextBox x:Name="VersionInput" Header=">> 部署版本号" 
                 Text="v0.6.0" 
                 FontFamily="{StaticResource TerminalFont}" Background="Transparent" Foreground="White"/>
    </StackPanel>
</ContentDialog>