<ContentDialog
    x:Class="BlueSapphire.Views.DevLogInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PanelSurface}"
    BorderBrush="{StaticResource BorderColor}"
    BorderThickness="1"
    CornerRadius="12"
    PrimaryButtonText="确认保存"
    CloseButtonText="取消"
    DefaultButton="Close"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonStyle="{StaticResource PrimaryActionButtonStyle}">

    <ContentDialog.Resources>
        <FontFamily x:Key="AppContentFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    </ContentDialog.Resources>

    <StackPanel Spacing="15" Width="500">
        <TextBlock x:Name="DialogTitleText" Text="添加更新记录" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource AppContentFont}"/>
        <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" HorizontalAlignment="Stretch" Margin="0,-5,0,5"/>

        <TextBox x:Name="TitleInput" Header="更新标题" PlaceholderText="例如：视觉重构与系统级优化" FontFamily="{StaticResource AppContentFont}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="VersionInput" Grid.Column="0" Header="构建版本" PlaceholderText="1.0.0" FontFamily="{StaticResource AppContentFont}"/>

            <ComboBox x:Name="LevelInput" Grid.Column="2" Header="记录分级" SelectedIndex="1" HorizontalAlignment="Stretch" FontFamily="{StaticResource AppContentFont}">
                <ComboBoxItem Content="核心跃迁"/>
                <ComboBoxItem Content="常规迭代"/>
            </ComboBox>

            <TextBox x:Name="DateInput" Grid.Column="4" Header="更新日期（留空为当前）" PlaceholderText="年-月-日" FontFamily="{StaticResource AppContentFont}"/>
        </Grid>

        <TextBox x:Name="DescInput" Header="版本摘要" PlaceholderText="请简要描述本次更新的核心业务变动…" Height="80" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource AppContentFont}"/>

        <StackPanel Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="完整技术文档（支持文本文件导入）" Foreground="{StaticResource TextMuted}" FontSize="12" FontFamily="{StaticResource AppContentFont}"/>
            <Button Content="选择本地文档" Click="SelectTxtFile_Click" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch" FontFamily="{StaticResource AppContentFont}"/>
            <TextBlock x:Name="FileStatusText" Text="尚未选择文件" Foreground="{StaticResource TextFaint}" FontSize="12"/>
            <TextBox x:Name="FullContentInput"
                     Header="完整文档正文"
                     PlaceholderText="可直接输入完整版本说明，或先导入 txt / md 文件后再继续编辑。"
                     Height="220"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontFamily="{StaticResource AppContentFont}"/>
        </StackPanel>

    </StackPanel>
</ContentDialog>
