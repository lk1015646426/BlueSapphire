<ContentDialog
    x:Class="BlueSapphire.Views.Dialogs.EnhanceImageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="自动增强"
    PrimaryButtonText="应用增强"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource PrimaryActionButtonStyle}"
    CloseButtonStyle="{StaticResource SubtleActionButtonStyle}"
    Style="{StaticResource WorkbenchContentDialogStyle}"
    DefaultButton="Close"
    Loaded="ContentDialog_Loaded">

    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="440" MaxWidth="560" Spacing="12">
            <Border x:Name="PreviewBorder" Height="190" Background="{ThemeResource MediaSurface}"
                    BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1" CornerRadius="8"
                    Visibility="Collapsed">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>

            <Border Background="{ThemeResource AccentSafeBg}" CornerRadius="6" Padding="10,8">
                <TextBlock Text="全部处理均在本机完成，不会上传图片；多选时统一应用参数。"
                           Foreground="{ThemeResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Style="{StaticResource DialogSectionStyle}">
                <StackPanel Spacing="10">
                    <Grid><TextBlock Text="亮度"/><TextBlock x:Name="BrightnessText" Text="0.0" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" StepFrequency="0.05" Value="0" ValueChanged="Slider_ValueChanged"/>
                    <Grid><TextBlock Text="对比度"/><TextBlock x:Name="ContrastText" Text="1.0" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="Slider_ValueChanged"/>
                    <Grid><TextBlock Text="饱和度"/><TextBlock x:Name="SaturationText" Text="1.0" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="Slider_ValueChanged"/>
                    <Grid><TextBlock Text="锐化"/><TextBlock x:Name="SharpnessText" Text="0.0" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="0" ValueChanged="Slider_ValueChanged"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
