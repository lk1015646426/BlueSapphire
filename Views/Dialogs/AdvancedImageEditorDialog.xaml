<ContentDialog
    x:Class="BlueSapphire.Views.Dialogs.AdvancedImageEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="裁剪、缩放与压缩"
    PrimaryButtonText="应用并导出"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource PrimaryActionButtonStyle}"
    CloseButtonStyle="{StaticResource SubtleActionButtonStyle}"
    Style="{StaticResource WorkbenchContentDialogStyle}"
    DefaultButton="Close"
    Loaded="ContentDialog_Loaded"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    MaxWidth="1200">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="780" MaxWidth="1080" MinHeight="480" MaxHeight="620"
          ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Background="{ThemeResource MediaSurface}"
                BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Viewbox x:Name="PreviewViewbox" Stretch="Uniform">
                <Grid x:Name="ImageGrid">
                    <Image x:Name="PreviewImage" Stretch="None" SizeChanged="PreviewImage_SizeChanged"/>
                    <Canvas x:Name="CropCanvas" Background="Transparent">
                        <Path Fill="#B3000000" IsHitTestVisible="False">
                            <Path.Data>
                                <GeometryGroup FillRule="EvenOdd">
                                    <RectangleGeometry x:Name="OuterMaskRect" Rect="0,0,100,100"/>
                                    <RectangleGeometry x:Name="InnerCropRect" Rect="10,10,80,80"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>

                        <Thumb x:Name="CenterDragThumb" DragDelta="CenterDragThumb_DragDelta" Background="Transparent">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Rectangle x:Name="CropBorder" Stroke="{ThemeResource AccentPrimary}"
                                   StrokeThickness="2" IsHitTestVisible="False"/>

                        <Thumb x:Name="ThumbT" Height="18" DragDelta="Thumb_DragDelta" Tag="T">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="ThumbB" Height="18" DragDelta="Thumb_DragDelta" Tag="B">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="ThumbL" Width="18" DragDelta="Thumb_DragDelta" Tag="L">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="ThumbR" Width="18" DragDelta="Thumb_DragDelta" Tag="R">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate></Thumb.Template>
                        </Thumb>

                        <Thumb x:Name="ThumbTL" Width="26" Height="26" DragDelta="Thumb_DragDelta" Tag="TL">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{ThemeResource PanelSurface}" Stroke="{ThemeResource AccentPrimary}" StrokeThickness="2" Width="15" Height="15"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="ThumbTR" Width="26" Height="26" DragDelta="Thumb_DragDelta" Tag="TR">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{ThemeResource PanelSurface}" Stroke="{ThemeResource AccentPrimary}" StrokeThickness="2" Width="15" Height="15"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="ThumbBL" Width="26" Height="26" DragDelta="Thumb_DragDelta" Tag="BL">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{ThemeResource PanelSurface}" Stroke="{ThemeResource AccentPrimary}" StrokeThickness="2" Width="15" Height="15"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="ThumbBR" Width="26" Height="26" DragDelta="Thumb_DragDelta" Tag="BR">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{ThemeResource PanelSurface}" Stroke="{ThemeResource AccentPrimary}" StrokeThickness="2" Width="15" Height="15"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,2,2">
                <InfoBar x:Name="BatchInfoBar" IsOpen="False" Severity="Informational"
                         Title="批量处理" Message="以下参数将应用到全部所选图片。"/>

                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="裁剪与尺寸" Style="{StaticResource DialogHeadingStyle}"/>
                                <TextBlock Text="调整裁剪范围与导出像素。" Style="{StaticResource DialogHelperTextStyle}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="EnableReshapeToggle" IsOn="True"
                                          Toggled="EnableReshapeToggle_Toggled" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel x:Name="ReshapePanel" Spacing="12">
                            <Grid>
                                <TextBlock Text="原始尺寸" Style="{StaticResource DialogHelperTextStyle}"/>
                                <TextBlock x:Name="OriginalSizeText" Text="-" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="裁剪比例" FontSize="12" FontWeight="SemiBold"/>
                                <ItemsControl>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ToggleButton x:Name="RatioBtn1x1" Content="1:1" Tag="1.0" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                    <ToggleButton x:Name="RatioBtn3x4" Content="3:4" Tag="0.75" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                    <ToggleButton x:Name="RatioBtn4x3" Content="4:3" Tag="1.33333333" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                    <ToggleButton x:Name="RatioBtn9x16" Content="9:16" Tag="0.5625" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                    <ToggleButton x:Name="RatioBtn16x9" Content="16:9" Tag="1.77777778" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                    <ToggleButton x:Name="RatioBtn2x3" Content="2:3" Tag="0.66666667" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                    <ToggleButton x:Name="RatioBtn3x2" Content="3:2" Tag="1.5" Margin="0,0,6,6" Style="{StaticResource DialogToggleChipStyle}" Click="RatioBtn_Click"/>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="导出尺寸" FontSize="12" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="OutputWidthBox" PlaceholderText="宽度" Minimum="0" Value="0" SpinButtonPlacementMode="Hidden"/>
                                    <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Foreground="{ThemeResource TextMuted}"/>
                                    <NumberBox x:Name="OutputHeightBox" Grid.Column="2" PlaceholderText="高度" Minimum="0" Value="0" SpinButtonPlacementMode="Hidden"/>
                                    <TextBlock Grid.Column="3" Text="像素" VerticalAlignment="Center" Foreground="{ThemeResource TextMuted}" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <Button Content="重置为居中裁剪" Click="ResetCropButton_Click"
                                    HorizontalAlignment="Stretch" Style="{StaticResource CompactButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DialogSectionStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="限制文件体积" Style="{StaticResource DialogHeadingStyle}"/>
                                <TextBlock Text="通过本地多次压缩控制导出大小。" Style="{StaticResource DialogHelperTextStyle}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="EnableTargetSizeToggle" IsOn="False"
                                          Toggled="EnableTargetSizeToggle_Toggled" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel x:Name="TargetSizePanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="MinSizeBox" PlaceholderText="最小" Minimum="1" Value="100" SpinButtonPlacementMode="Hidden"/>
                                <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Center" Foreground="{ThemeResource TextMuted}"/>
                                <NumberBox x:Name="MaxSizeBox" Grid.Column="2" PlaceholderText="最大" Minimum="1" Value="500" SpinButtonPlacementMode="Hidden"/>
                                <ComboBox x:Name="TargetSizeUnitCombo" Grid.Column="3" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="KB"/><ComboBoxItem Content="MB"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="限制体积时统一导出为 JPEG；处理过程不会覆盖原文件。"
                                       Style="{StaticResource DialogHelperTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
