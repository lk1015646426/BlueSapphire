<ContentDialog
    x:Class="BlueSapphire.Views.Dialogs.FormatConvertDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="格式转换"
    PrimaryButtonText="转换"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="300" Margin="0,12,0,0">
        <ComboBox Header="目标格式" x:Name="FormatComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FormatComboBox_SelectionChanged">
            <ComboBoxItem Content="JPEG (.jpg)" Tag="Jpeg"/>
            <ComboBoxItem Content="PNG (.png)" Tag="Png"/>
            <ComboBoxItem Content="BMP (.bmp)" Tag="Bmp"/>
        </ComboBox>

        <StackPanel x:Name="QualityPanel" Spacing="8">
            <TextBlock x:Name="QualityText" Text="压缩质量: 92%" />
            <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="92" ValueChanged="QualitySlider_ValueChanged" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
