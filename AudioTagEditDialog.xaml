<ContentDialog
    x:Class="BlueSapphire.AudioTagEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑音频标签"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer MaxHeight="700" Width="500">
        <StackPanel Spacing="14">
            <Border Background="#10F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SummaryTextBlock" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HintTextBlock" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ArtworkHintTextBlock" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="TitlePanel" Spacing="6">
                <CheckBox x:Name="ApplyTitleCheckBox" Content="更新标题" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="TitleTextBox" PlaceholderText="留空表示清空标题" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyArtistCheckBox" Content="更新艺术家" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="ArtistTextBox" PlaceholderText="留空表示清空艺术家" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyAlbumCheckBox" Content="更新专辑" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="AlbumTextBox" PlaceholderText="留空表示清空专辑" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyAlbumArtistCheckBox" Content="更新专辑艺术家" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="AlbumArtistTextBox" PlaceholderText="留空表示清空专辑艺术家" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyComposerCheckBox" Content="更新作曲" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="ComposerTextBox" PlaceholderText="留空表示清空作曲" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyGenreCheckBox" Content="更新流派" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="GenreTextBox" PlaceholderText="留空表示清空流派" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel x:Name="TrackPanel" Spacing="6">
                <CheckBox x:Name="ApplyTrackCheckBox" Content="更新曲序" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="TrackTextBox" PlaceholderText="留空表示清空曲序" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyYearCheckBox" Content="更新年份" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="YearTextBox" PlaceholderText="留空表示清空年份" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyDiscCheckBox" Content="更新碟序" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="DiscTextBox" PlaceholderText="留空表示清空碟序" IsEnabled="False" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyCommentCheckBox" Content="更新备注" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="CommentTextBox" PlaceholderText="留空表示清空备注" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <CheckBox x:Name="ApplyLyricsCheckBox" Content="更新歌词" Checked="FieldStateChanged" Unchecked="FieldStateChanged"/>
                <TextBox x:Name="LyricsTextBox" PlaceholderText="留空表示清空歌词" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" TextChanged="FieldValueChanged"/>
            </StackPanel>

            <TextBlock x:Name="ValidationTextBlock" Foreground="#FFFF6B6B" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
