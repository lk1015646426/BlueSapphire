<Window
    x:Class="BlueSapphire.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout" Background="{StaticResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <canvas:CanvasControl x:Name="BackgroundCanvas"
                              Grid.Row="0" Grid.RowSpan="2"
                              Draw="OnDraw"
                              CreateResources="OnCreateResources"
                              IsHitTestVisible="False"
                              ClearColor="Transparent"/>

        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="8">
                <Image Source="ms-appx:///BS.ico"
                       Width="16"
                       Height="16"
                       Stretch="Uniform"
                       IsHitTestVisible="False"/>
                <TextBlock Text="蓝宝石工具箱"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </Border>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        SelectionChanged="NavView_SelectionChanged"
                        PaneDisplayMode="Auto"
                        PaneTitle=""
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        Background="{x:Null}"
                        AlwaysShowHeader="False"
                        IsPaneOpen="True"
                        OpenPaneLength="232"
                        CompactPaneLength="56"
                        CompactModeThresholdWidth="720"
                        ExpandedModeThresholdWidth="1060">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>

        </NavigationView>
    </Grid>
</Window>
