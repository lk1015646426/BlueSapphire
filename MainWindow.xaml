<Window
    x:Class="BlueSapphire.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootLayout" Background="{ThemeResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource PanelSurface}"
                BorderBrush="{ThemeResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar"/>
        </Border>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        SelectionChanged="NavView_SelectionChanged"
                        PaneDisplayMode="Auto"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        AlwaysShowHeader="False"
                        IsPaneOpen="True"
                        OpenPaneLength="248"
                        CompactPaneLength="56"
                        CompactModeThresholdWidth="760"
                        ExpandedModeThresholdWidth="1040"
                        Background="{ThemeResource BgColor}"
                        BorderBrush="{ThemeResource BorderSubtle}"
                        BorderThickness="0">

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="更新日志" Tag="DevLog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ThemeToggleItem" Content="深色模式" Tag="ThemeToggle">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE708;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"
                   HorizontalContentAlignment="Stretch"
                   VerticalContentAlignment="Stretch"/>
        </NavigationView>
    </Grid>
</Window>
