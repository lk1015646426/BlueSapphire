<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BlueSapphire.Controls.DonutChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="清理空间摘要">

    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="96" Height="96">
            <Ellipse Width="86" Height="86" Stroke="{ThemeResource BorderSubtle}" StrokeThickness="10" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse x:Name="SafeRing" Width="86" Height="86" Stroke="{ThemeResource AccentSafe}" StrokeThickness="10" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="ReviewRing" Width="86" Height="86" Stroke="{ThemeResource AccentReview}" StrokeThickness="10" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="SystemRing" Width="86" Height="86" Stroke="{ThemeResource AccentPrimary}" StrokeThickness="10" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="ViewOnlyRing" Width="86" Height="86" Stroke="{ThemeResource AccentInspect}" StrokeThickness="10" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>

            <StackPanel x:Name="DataPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="已识别" FontSize="11" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalText" Text="--" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextMain}" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="IdlePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="待扫描" FontSize="11" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel x:Name="NoResultsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{ThemeResource AccentSafe}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="NoResultsLabel" Text="没有需要处理的空间" FontSize="11" Foreground="{ThemeResource AccentSafe}" HorizontalAlignment="Center" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
