<Page
    x:Class="BlueSapphire.CleanerAssistantPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>

        <SolidColorBrush x:Key="BgColor" Color="#091114"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#0D171B"/>
        <SolidColorBrush x:Key="PanelSurfaceStrong" Color="#101E23"/>
        <SolidColorBrush x:Key="PanelHighlight" Color="#123039"/>
        <SolidColorBrush x:Key="TextMain" Color="#E4F2EF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7A9796"/>
        <SolidColorBrush x:Key="AccentSafe" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentSafeBg" Color="#1422C55E"/>
        <SolidColorBrush x:Key="AccentReview" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentReviewBg" Color="#18F59E0B"/>
        <SolidColorBrush x:Key="AccentInspect" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentInspectBg" Color="#1638BDF8"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelHighlight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="CardBorderStrongStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurfaceStrong}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="ListItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="26,18,26,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SPACE GOVERNANCE" FontSize="10" Foreground="{StaticResource TextMuted}" CharacterSpacing="120"/>
                <TextBlock Text="清理助手" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                <TextBlock Text="先解释空间，再执行清理；默认保守，支持恢复和排除。" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.StartQuickScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C3;" Foreground="{StaticResource AccentSafe}"/>
                        <TextBlock Text="快速扫描"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.StartDeepScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE81E;" Foreground="{StaticResource AccentInspect}"/>
                        <TextBlock Text="深度扫描"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind ViewModel.RunCleanupCommand}"
                        Background="{StaticResource AccentSafeBg}"
                        BorderBrush="{StaticResource AccentSafe}"
                        IsEnabled="{x:Bind ViewModel.CanRunCleanup, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AccentSafe}"/>
                        <TextBlock Text="执行清理" Foreground="{StaticResource AccentSafe}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" Margin="26,18,26,24">
            <TabView.TabItems>
                <TabViewItem Header="扫描与清理" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Padding="0,0,16,0">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="可安全清理" Foreground="{StaticResource AccentSafe}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.SafeSpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.SafeCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="建议确认后清理" Foreground="{StaticResource AccentReview}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.ReviewSpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.ReviewCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="仅供查看" Foreground="{StaticResource AccentInspect}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.ViewOnlySpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.ViewOnlyCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStrongStyle}" Padding="18,16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StatusMainText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}" Height="6" CornerRadius="999"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanModeText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{x:Bind ViewModel.CancelCurrentOperationCommand}"
                                        Visibility="{x:Bind ViewModel.CanCancelCurrentOperation, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                        Margin="12,0,0,0">
                                    <TextBlock Text="取消"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander Visibility="{x:Bind ViewModel.HasSafeItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                              Header="可安全清理明细"
                              IsExpanded="False">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SafeItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerScanItem">
                                    <Border Style="{StaticResource ListItemBorderStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource AccentSafe}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentSafe}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4">
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind SizeText}" Foreground="{StaticResource TextMain}" FontSize="11"/></Border>
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind CategoryText}" Foreground="{StaticResource TextMuted}" FontSize="11"/></Border>
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind ExecutionModeText}" Foreground="{StaticResource TextMuted}" FontSize="11"/></Border>
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind FileCountText}" Foreground="{StaticResource TextMuted}" FontSize="11"/></Border>
                                                </WrapGrid>
                                                <TextBlock Text="{x:Bind StatusHintText}" Foreground="{StaticResource AccentSafe}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind WhyItCanBeCleaned}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind OwnerApp}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenItemLocationCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="打开位置"/></Button>
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.AddToExclusionsCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="加入排除"/></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Visibility="{x:Bind ViewModel.HasReviewItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                              Header="建议确认后清理明细"
                              IsExpanded="False">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReviewItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerScanItem">
                                    <Border Style="{StaticResource ListItemBorderStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentReviewBg}" BorderBrush="{StaticResource AccentReview}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentReview}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind RiskSummary}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind ImpactAfterCleanup}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind OwnerApp}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenItemLocationCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="打开位置"/></Button>
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.AddToExclusionsCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="加入排除"/></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Visibility="{x:Bind ViewModel.HasViewOnlyItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                              Header="仅供查看明细"
                              IsExpanded="False">
                        <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ViewOnlyDisplayHintText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasHiddenViewOnlyItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ViewOnlyItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerScanItem">
                                    <Border Style="{StaticResource ListItemBorderStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentInspectBg}" BorderBrush="{StaticResource AccentInspect}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentInspect}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind RiskSummary}" Foreground="{StaticResource AccentInspect}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind OwnerApp}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenItemLocationCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="打开位置"/></Button>
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.AddToExclusionsCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="加入排除"/></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <StackPanel Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}" HorizontalAlignment="Center" Margin="0,30,0,0" Spacing="8">
                        <TextBlock Text="还没有扫描结果" Foreground="{StaticResource TextMain}" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="先跑一次快速扫描，把明确可清的空间找出来。" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="高级设置与日志" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Padding="0,0,16,0">
                        <StackPanel Spacing="18">
                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14"
                        Visibility="{x:Bind ViewModel.HasDriveOptions, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="磁盘选择" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedDriveSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.DriveSelectionHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.SelectAllDrivesCommand}">
                                <TextBlock Text="全选磁盘"/>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.UseSystemDriveOnlyCommand}">
                                <TextBlock Text="仅系统盘"/>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DriveOptions, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerDriveOption">
                                    <Border Margin="0,0,0,8" Padding="10,9" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind TitleText}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind SubtitleText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind CapacityText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <ProgressBar Value="{x:Bind UsedPercentage, Mode=OneWay}" Maximum="100" Height="5" CornerRadius="999" Margin="0,3,0,0"/>
                                                <TextBlock Text="{x:Bind UsageText}" Foreground="{StaticResource AccentInspect}" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="规则库" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.RulePackSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.RulePackDetailText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RulePackSourceText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RulePackRefreshText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.RulePackRemoteUriText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RulePackHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.ImportRulePackCommand}">
                                <TextBlock Text="导入规则包"/>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.RefreshRulePackFromUrlCommand}">
                                <TextBlock Text="从链接刷新"/>
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.OpenRulePackDirectoryCommand}">
                                <TextBlock Text="打开规则目录"/>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.ClearExternalRulePackCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasExternalRulePack, Mode=OneWay}">
                                <TextBlock Text="恢复内置规则"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="云端治理" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.RolloutSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.RolloutDetailText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RolloutHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="灰度通道" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.SetStableRolloutChannelCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanChooseStableRollout, Mode=OneWay}">
                                <TextBlock Text="Stable"/>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.SetCanaryRolloutChannelCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanChooseCanaryRollout, Mode=OneWay}">
                                <TextBlock Text="Canary"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.SetInternalRolloutChannelCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanChooseInternalRollout, Mode=OneWay}">
                                <TextBlock Text="Internal"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TelemetrySummaryText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.TelemetryDetailText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <ToggleSwitch Header="遥测摘要" />
                        <TextBlock Text="{x:Bind ViewModel.TelemetryEndpointText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.TelemetryLastUploadText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.ConfigureTelemetryEndpointCommand}">
                                <TextBlock Text="配置上传地址"/>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.UploadTelemetryNowCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanUploadTelemetryNow, Mode=OneWay}">
                                <TextBlock Text="立即上传摘要"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="权限模式" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.PrivilegeModeText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.PrivilegeModeHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.SystemBoundaryHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Command="{x:Bind ViewModel.EnterElevatedModeCommand}"
                                Visibility="{x:Bind ViewModel.CanEnterElevatedMode, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7EF;" Foreground="{StaticResource AccentInspect}"/>
                                <TextBlock Text="进入管理员模式"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="本次计划" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="只会执行你当前勾选的项目；高风险对象默认不参与。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="运行摘要" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.AuditScanSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.AuditCleanupSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.AuditRestoreSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.AuditRetrySummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.AuditUserChoiceSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.AuditFailureSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="质量治理" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.QualityGovernanceHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.QualityGovernanceDetailText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.QualityGovernanceHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.ExportDiagnosticReportCommand}">
                                <TextBlock Text="导出诊断报告"/>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.EnableAllLocallyDisabledRulesCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasLocallyDisabledRules, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.QualityGovernanceActionText, Mode=OneWay}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="智能推荐" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.RecommendationHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.RecommendationDetailText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RecommendationProfileText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendationEntries, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasRecommendationEntries, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerRecommendationEntry">
                                    <Border Margin="0,0,0,8" Padding="10,9" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ActionText}" Foreground="{StaticResource AccentInspect}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="空间趋势" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendDeltaText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendCompositionText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendWindowText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendScopeText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.ScanTrendReuseText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ScanTrendEntries, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasScanTrendHistory, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerScanTrendEntry">
                                    <Border Margin="0,0,0,8" Padding="10,9" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind TimestampText}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind ScopeText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind TotalText}" Foreground="{StaticResource AccentInspect}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind DeltaText}" Foreground="{StaticResource TextMain}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind CompositionText}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind DriveSummaryText}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ReuseText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="定时保洁" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.AutomationSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.AutomationModeText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <ToggleSwitch Header="到期提醒我进行清理" />
                        <ToggleSwitch Header="到期后自动清理低风险项" />
                        <TextBlock Text="提醒周期" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <ComboBox PlaceholderText="选择提醒周期" />
                        <TextBlock Text="{x:Bind ViewModel.AutomationNextActionText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.AutomationLastActionText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.AutomationScheduleText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.AutomationScheduleDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.AutomationHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Command="{x:Bind ViewModel.RunAutomaticLowRiskCleanupNowCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRunAutomaticLowRiskCleanupNow, Mode=OneWay}">
                            <TextBlock Text="立即执行一次低风险保洁"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="最近一次清理" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.LatestCleanupSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.LatestCleanupHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                        <Border Background="#0FFFFFFF"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10"
                                Visibility="{x:Bind ViewModel.HasLatestCleanupFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="失败处理建议" Foreground="{StaticResource AccentReview}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.FailureRecoveryHeadlineText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.FailureRecoveryDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.FailureRecoveryProcessText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasFailureRecoveryProcesses, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                           Foreground="{StaticResource AccentReview}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Command="{x:Bind ViewModel.RetryFailedCleanupEntriesCommand}"
                                            Visibility="{x:Bind ViewModel.HasRetryableFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="重试失败项"/>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Command="{x:Bind ViewModel.EnterElevatedModeAndRetryFailuresCommand}"
                                            Visibility="{x:Bind ViewModel.CanElevateAndRetryFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.FailureRecoveryElevateActionText, Mode=OneWay}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.RestoreLatestCleanupCommand}" IsEnabled="{x:Bind ViewModel.HasRestorableBatch, Mode=OneWay}">
                            <TextBlock Text="恢复最近一次清理"/>
                        </Button>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.OpenQuarantineCommand}"><TextBlock Text="打开隔离区"/></Button>
                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.OpenCleanerWorkspaceCommand}"><TextBlock Text="打开记录目录"/></Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14"
                        Visibility="{x:Bind ViewModel.HasLatestCleanupEntries, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="最近批次明细" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LatestCleanupEntries, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CleanerCleanupEntry">
                                        <Border Margin="0,0,0,8" Padding="10,9" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind ItemName}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind StatusText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Top"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind FailureSummary}" Visibility="{x:Bind HasFailure, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind ErrorMessage}" Visibility="{x:Bind HasFailure, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind RecoveryHint}" Visibility="{x:Bind HasRecoveryHint, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentInspect}" FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="11" TextWrapping="Wrap"/>
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenCleanupEntryOriginalPathCommand, ElementName=RootPage}" CommandParameter="{Binding}">
                                                        <TextBlock Text="原位置"/>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenCleanupEntryBackupPathCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind HasBackupPath, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="隔离区"/>
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.RestoreCleanupEntryCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind CanRestoreEntry, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="恢复此项"/>
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource ActionButtonStyle}"
                                                            Command="{Binding ViewModel.DisableRuleFromCleanupEntryCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{x:Bind CanDisableRule, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="停用规则"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="排除列表" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ExclusionSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Exclusions, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasExclusions, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerExclusionEntry">
                                    <Border Margin="0,0,0,8" Padding="10,8" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind DisplayName}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.RemoveExclusionCommand, ElementName=RootPage}" CommandParameter="{Binding}">
                                                <TextBlock Text="移除"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="在任意清理项上点击“加入排除”后，后续扫描将跳过该路径。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
