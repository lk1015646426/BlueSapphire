                                                        <TextBlock Text="原位置"/>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.Cleanup.OpenCleanupEntryBackupPathCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind HasBackupPath, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="隔离区"/>
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.Cleanup.RestoreCleanupEntryCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind CanRestoreEntry, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="恢复此项"/>
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource ActionButtonStyle}"
                                                            Command="{Binding ViewModel.Rule.DisableRuleFromCleanupEntryCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{x:Bind CanDisableRule, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="停用规则"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="质量治理" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceDetailText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Rule.ExportDiagnosticReportCommand}">
                                <TextBlock Text="导出诊断报告"/>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{x:Bind ViewModel.Rule.EnableAllLocallyDisabledRulesCommand}"
                                    IsEnabled="{x:Bind ViewModel.Rule.HasLocallyDisabledRules, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceActionText, Mode=OneWay}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="排除列表" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.Cleanup.ExclusionSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Cleanup.Exclusions, Mode=OneWay}" Visibility="{x:Bind ViewModel.Cleanup.HasExclusions, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerExclusionEntry">
                                    <Border Margin="0,0,0,8" Padding="10,8" Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind DisplayName}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.Cleanup.RemoveExclusionCommand, ElementName=RootPage}" CommandParameter="{Binding}">
                                                <TextBlock Text="移除"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="在任意清理项上点击“加入排除”后，后续扫描将跳过该路径。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>
