<Page
    x:Class="BlueSapphire.CleanerAssistantPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    xmlns:controls="using:BlueSapphire.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:UsageToBrushConverter x:Key="UsageToBrushConverter"/>
        <Storyboard x:Name="CardEntrance">
            <DoubleAnimation Storyboard.TargetName="ScanContentPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScanContentTranslate" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="CleanupEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="CleanupExperience" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CleanupCardTransform" Storyboard.TargetProperty="TranslateY" From="10" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CleanupCardTransform" Storyboard.TargetProperty="ScaleX" From="0.98" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="CleanupCardTransform" Storyboard.TargetProperty="ScaleY" From="0.98" To="1" Duration="0:0:0.22"/>
        </Storyboard>
        <Storyboard x:Name="CleanupOutcomeStoryboard">
            <DoubleAnimation Storyboard.TargetName="CleanupOutcomePanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.20"/>
            <DoubleAnimation Storyboard.TargetName="CleanupOutcomeTranslate" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CleanupOutcomeIconScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CleanupOutcomeIconScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="CleanerLayoutRoot" Background="{ThemeResource BgColor}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SectionRailColumn.Width" Value="0"/>
                        <Setter Target="ContentHost.Padding" Value="6"/>
                        <Setter Target="MainTabBar.Visibility" Value="Collapsed"/>
                        <Setter Target="ScanPrimaryColumn.Width" Value="*"/>
                        <Setter Target="ScanDetailColumn.Width" Value="0"/>
                        <Setter Target="ScanDetailColumn.MinWidth" Value="0"/>
                        <Setter Target="ScanDetailPanel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SectionRailColumn.Width" Value="156"/>
                        <Setter Target="MainTabBar.Visibility" Value="Visible"/>
                        <Setter Target="ContentHost.Padding" Value="12"/>
                        <Setter Target="ScanPrimaryColumn.Width" Value="6*"/>
                        <Setter Target="ScanDetailColumn.Width" Value="4*"/>
                        <Setter Target="ScanDetailColumn.MinWidth" Value="240"/>
                        <Setter Target="ScanDetailPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Grid Grid.Row="0" Padding="18,8" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="清理助手" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource PanelSurfaceStrong}" BorderThickness="0" CornerRadius="7" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Scan.StatusMainText, Mode=OneWay}" Foreground="{StaticResource AccentPrimary}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="把占用来源、删除影响和真实释放空间讲清楚，再由你决定。" FontSize="11" Foreground="{ThemeResource TextMuted}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Scan.StartQuickScanCommand}" IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="{StaticResource AccentSafe}"/><TextBlock Text="快速扫描"/></StackPanel>
                </Button>
                <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Scan.StartDeepScanCommand}" IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE81E;" FontSize="13" Foreground="{StaticResource AccentInspect}"/><TextBlock Text="深度扫描"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Workbench section rail: persistent task navigation, content stays in place. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SectionRailColumn" Width="156"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tab Strip -->
            <ListView x:Name="MainTabBar" Grid.Column="0" SelectionChanged="MainTabBar_SelectionChanged"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{ThemeResource PanelSurface}" Padding="10,12"
                      BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,1,1,0"
                      SelectionMode="Single" IsItemClickEnabled="False">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{ThemeResource TextMuted}"/>
                        <Setter Property="UseSystemFocusVisuals" Value="True"/>
                        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentPrimary}"/>
                        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource TextMain}"/>
                        <Setter Property="FocusVisualMargin" Value="-2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="ContentPresenter"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                        <Border x:Name="Indicator"
                                                Width="3"
                                                Background="Transparent"
                                                VerticalAlignment="Stretch"
                                                HorizontalAlignment="Left"
                                                Margin="-12,0,0,0"
                                                CornerRadius="1.5"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextSecondary}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="ContentPresenter.Opacity" Value="0.7"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextMain}"/>
                                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource AccentPrimaryBg}"/>
                                                        <Setter Target="Indicator.Background" Value="{ThemeResource AccentPrimary}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextMain}"/>
                                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource AccentPrimaryBg}"/>
                                                        <Setter Target="Indicator.Background" Value="{ThemeResource AccentPrimary}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Target="ContentPresenter.Opacity" Value="0.35"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListViewItem>清理</ListViewItem>
                <ListViewItem>自动化与规则</ListViewItem>
                <ListViewItem>记录</ListViewItem>
            </ListView>

            <!-- Tab Content Area — stretches to fill remaining height -->
            <Grid x:Name="ContentHost" Grid.Column="1" Padding="12">

                <!-- ═══════════════════════════════════════════════ -->
                <!-- Tab 1: 扫描与清理                                -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid x:Name="Tab1Content">
                    <Grid x:Name="ScanContentPanel" Opacity="0" Padding="2,2,2,2">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ScanContentTranslate"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ScanPrimaryColumn" Width="6*" MinWidth="320"/>
                                <ColumnDefinition x:Name="ScanDetailColumn" Width="4*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <!-- ══ LEFT COLUMN ══ -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                <StackPanel Spacing="10" Margin="2,0,2,2">

                                    <!-- ── Scan Range ── -->
                                    <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,10"
                                            Visibility="{x:Bind ViewModel.Drive.HasDriveOptions, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xEDA2;" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Text="扫描范围" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind ViewModel.Drive.SelectedDriveSummaryText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                                        <TextBlock Text="{x:Bind ViewModel.Drive.DriveSelectionHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Drive.UseSystemDriveOnlyCommand}" IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}"><TextBlock Text="仅系统盘"/></Button>
                                                    <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Drive.SelectAllDrivesCommand}" IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}"><TextBlock Text="全选"/></Button>
                                                </StackPanel>
                                            </Grid>
                                            <ListView ItemsSource="{x:Bind ViewModel.Drive.DriveOptions, Mode=OneWay}"
                                                      IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}"
                                                      SelectionMode="None" MaxHeight="156" BorderThickness="0">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                                        <Setter Property="MinHeight" Value="0"/>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CleanerDriveOption">
                                                        <Grid>
                                                            <Border IsHitTestVisible="False"
                                                                    Background="{ThemeResource PanelSurface}"
                                                                    CornerRadius="7"/>
                                                            <Border IsHitTestVisible="False"
                                                                    Background="{ThemeResource AccentPrimaryBg}"
                                                                    CornerRadius="7"
                                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                                                            <Border Background="Transparent"
                                                                    BorderBrush="{ThemeResource BorderSubtle}"
                                                                    BorderThickness="1" CornerRadius="7" Padding="10,6">
                                                                <Grid ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="1.1*"/>
                                                                        <ColumnDefinition Width="0.9*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                              AutomationProperties.Name="选择扫描磁盘"
                                                                              VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind TitleText}" FontSize="13" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{x:Bind SubtitleText}" Style="{StaticResource TextStyle_Caption}"/>
                                                                    </StackPanel>
                                                                    <ProgressBar Grid.Column="2" Value="{x:Bind UsedPercentage, Mode=OneWay}"
                                                                                 Maximum="100" Height="6" CornerRadius="6"
                                                                                 Foreground="{x:Bind UsedPercentage, Mode=OneWay, Converter={StaticResource UsageToBrushConverter}}"
                                                                                 VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{x:Bind UsageText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                        <TextBlock Text="{x:Bind CapacitySummaryText, Mode=OneWay}" FontSize="10"
                                                                                   Foreground="{ThemeResource TextMuted}" MaxWidth="160"
                                                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <Border IsHitTestVisible="False" Background="Transparent"
                                                                    BorderBrush="{ThemeResource AccentPrimary}" BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button x:Name="InlineQuickScanButton"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    Command="{x:Bind ViewModel.Scan.StartQuickScanCommand}"
                                                    IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                                                    <TextBlock Text="开始快速扫描"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- ── Result summary: one hierarchy, no nested metric cards ── -->
                                    <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                                        <Grid>

                                            <!-- Idle state -->
                                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.Scan.IsIdle, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentPrimaryBg}" BorderThickness="0" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE909;" FontSize="18" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="选择磁盘后开始扫描" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Scanning state -->
                                            <StackPanel Spacing="10" HorizontalAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.Scan.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.Scan.ScanningProgressText, Mode=OneWay}" Style="{StaticResource TextStyle_MetricLarge}" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.Scan.StatusDetailText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/>
                                                <ProgressBar Value="{x:Bind ViewModel.Scan.ProgressValue, Mode=OneWay}"
                                                             Maximum="{x:Bind ViewModel.Scan.ProgressMax, Mode=OneWay}"
                                                             Foreground="{ThemeResource AccentPrimary}"
                                                             Height="5" CornerRadius="7" Width="300"/>
                                                <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Scan.CancelCurrentOperationCommand}" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="11"/><TextBlock Text="取消扫描"/></StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Completed with results -->
                                            <StackPanel Spacing="14"
                                                        Visibility="{x:Bind ViewModel.Scan.HasAnyCategoryItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <Grid ColumnSpacing="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock Text="本次扫描发现" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                        <TextBlock Text="{x:Bind ViewModel.Scan.TotalCleanableSpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="28" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource AccentSafe}"/>
                                                            <TextBlock Text="{x:Bind ViewModel.Scan.ScanModeText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="13"/>
                                                        </StackPanel>
                                                        <TextBlock Text="先核对建议确认项，再决定本次清理范围" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" MaxWidth="320"/>
                                                    </StackPanel>
                                                    <controls:DonutChart x:Name="DonutChart" Grid.Column="1" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Height="1" Background="{StaticResource BorderSubtle}"/>
                                                <Grid ColumnSpacing="28" RowSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentSafe}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"><TextBlock Text="低风险可清理" Foreground="{StaticResource TextMain}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.Scan.SafeCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10"/></StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Scan.SafeSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentReview}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"><TextBlock Text="建议确认" Foreground="{StaticResource TextMain}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.Scan.ReviewCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10"/></StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Scan.ReviewSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"><TextBlock Text="Windows 专用" Foreground="{StaticResource TextMain}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.Scan.SystemCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10"/></StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Scan.SystemSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentInspect}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"><TextBlock Text="仅供查看" Foreground="{StaticResource TextMain}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.Scan.ViewOnlyCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10"/></StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Scan.ViewOnlySpaceText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>

                                            <!-- No results state -->
                                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.Scan.ShowNoResultsState, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentSafeBg}" BorderThickness="0" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{StaticResource AccentSafe}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="未发现可清理项目" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="当前系统状态良好" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                                <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Scan.StartDeepScanCommand}" IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE81E;" FontSize="11" Foreground="{StaticResource AccentInspect}"/><TextBlock Text="尝试深度扫描"/></StackPanel>
                                                </Button>
                                            </StackPanel>

                                        </Grid>
                                    </Border>

                                    <!-- ── Safe Items Group ── -->
                                    <Expander Visibility="{x:Bind ViewModel.Scan.HasSafeItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"
                                              CornerRadius="8" Background="{StaticResource PanelSurfaceStrong}" BorderThickness="0" Padding="12,8">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8" Background="{StaticResource AccentSafeBg}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentSafe}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="低风险可清理项" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="来源明确、通常可重新生成；仍可点开核对" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.Scan.SafeSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="15" FontWeight="Bold"/>
                                                    <Border Background="{StaticResource AccentSafeBg}" CornerRadius="7" Padding="7,1">
                                                        <TextBlock Text="{x:Bind ViewModel.Scan.SafeCountText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Scan.SafeItems, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CleanerScanItem">
                                                    <Border Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,5">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Center" MinWidth="0" MinHeight="0" Padding="0"/>
                                                            <Border Grid.Column="1" Background="Transparent" Tapped="ItemRow_Tapped" Padding="0">
                                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="3" Background="{StaticResource AccentSafeBg}" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentSafe}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- ── Review Items Group ── -->
                                    <Expander Visibility="{x:Bind ViewModel.Scan.HasReviewItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False"
                                              CornerRadius="8" Background="{StaticResource PanelSurfaceStrong}" BorderThickness="0" Padding="12,8">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8" Background="{StaticResource AccentReviewBg}">
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{StaticResource AccentReview}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="建议确认项" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="需逐项确认，默认不全选" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.Scan.ReviewSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="15" FontWeight="Bold"/>
                                                    <Border Background="{StaticResource AccentReviewBg}" CornerRadius="7" Padding="7,1">
                                                        <TextBlock Text="{x:Bind ViewModel.Scan.ReviewCountText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Scan.ReviewItems, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CleanerScanItem">
                                                    <Border Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,5">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Center" MinWidth="0" MinHeight="0" Padding="0"/>
                                                            <Border Grid.Column="1" Background="Transparent" Tapped="ItemRow_Tapped" Padding="0">
                                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="3" Background="{StaticResource AccentReviewBg}" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentReview}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- ── Windows system actions ── -->
                                    <Expander Visibility="{x:Bind ViewModel.Scan.HasSystemItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"
                                              CornerRadius="8" Background="{StaticResource PanelSurfaceStrong}" BorderThickness="0" Padding="12,8">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8" Background="{StaticResource AccentPrimaryBg}">
                                                    <FontIcon Glyph="&#xE770;" FontSize="11" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="Windows 专用清理" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="调用系统支持的清理能力，不直接硬删系统组件" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.Scan.SystemSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentPrimary}" FontSize="15" FontWeight="Bold"/>
                                                    <Border Background="{StaticResource AccentPrimaryBg}" CornerRadius="7" Padding="7,1">
                                                        <TextBlock Text="{x:Bind ViewModel.Scan.SystemCountText, Mode=OneWay}" Foreground="{StaticResource AccentPrimary}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Scan.SystemItems, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CleanerScanItem">
                                                    <Border Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,5">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Center" MinWidth="0" MinHeight="0" Padding="0"/>
                                                            <Border Grid.Column="1" Background="Transparent" Tapped="ItemRow_Tapped" Padding="0">
                                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="3" Background="{StaticResource AccentPrimaryBg}" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                                                                <TextBlock Text="系统执行" Foreground="{StaticResource AccentPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- ── ViewOnly Items Group ── -->
                                    <Expander Visibility="{x:Bind ViewModel.Scan.HasViewOnlyItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False"
                                              CornerRadius="8" Background="{StaticResource PanelSurfaceStrong}" BorderThickness="0" Padding="12,8">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8" Background="{StaticResource AccentInspectBg}">
                                                    <FontIcon Glyph="&#xE9CE;" FontSize="11" Foreground="{StaticResource AccentInspect}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="仅供查看" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="大文件、疑似残留或系统对象，不进入一键清理" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.Scan.ViewOnlySpaceText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="15" FontWeight="Bold"/>
                                                    <Border Background="{StaticResource AccentInspectBg}" CornerRadius="7" Padding="7,1">
                                                        <TextBlock Text="{x:Bind ViewModel.Scan.ViewOnlyCountText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Scan.ViewOnlyItems, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CleanerScanItem">
                                                    <Border Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10" Padding="10,8" Margin="0,0,0,5">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentInspectBg}" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8E7;" FontSize="10" Foreground="{StaticResource AccentInspect}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border Grid.Column="1" Background="Transparent" Tapped="ItemRow_Tapped" Padding="0">
                                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>

                            <!-- ══ RIGHT COLUMN: Detail Panel ══ -->
                            <Border x:Name="ScanDetailPanel" Grid.Column="1" Background="{StaticResource PanelSurfaceStrong}" BorderThickness="0" CornerRadius="8" Padding="14,12">
                                <Grid>

                                    <!-- Default: scan mode description -->
                                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelectedScanItem, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource AccentPrimary}"/>
                                                <TextBlock Text="扫描说明" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Border Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10" Padding="12,10">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="{StaticResource AccentSafe}"/>
                                                        <TextBlock Text="{x:Bind ViewModel.Scan.ScanModeNameText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.Scan.ScanModeDescriptionText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="预计耗时" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Scan.ScanModeEstimateText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                            </Grid>
                                            <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource AccentSafe}"/>
                                                        <TextBlock Text="安全说明" Foreground="{StaticResource AccentSafe}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="内置规则不会把文档、照片等个人内容默认设为可清理。所有对象都可在执行前逐项核对，建议确认项默认不选择。"
                                                               Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.Scan.ScanModeSafetyText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Selected item detail -->
                                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelectedScanItem, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedScanItem.Name, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.SizeText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Background="{StaticResource AccentReviewBg}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.RiskText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.Description, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Border Background="{StaticResource AccentPrimaryBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.StatusHintText, Mode=OneWay}" Foreground="{StaticResource AccentPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Spacing="7">
                                                <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="为什么会占空间" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.WhyItConsumesSpace, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="为什么可以清理" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.WhyItCanBeCleaned, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{StaticResource AccentReviewBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="风险判断依据" Foreground="{StaticResource AccentReview}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.RiskSummary, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.RiskDetail, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Border Background="{StaticResource AccentPrimaryBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                    Visibility="{x:Bind ViewModel.SelectedScanItem.HasAIAnalysis, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE99A;" FontSize="11" Foreground="{StaticResource AccentPrimary}"/>
                                                        <TextBlock Text="AI 辅助解释（不改变安全规则）" Foreground="{StaticResource AccentPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.AIAnalysisText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.AIRecommendationText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Spacing="7">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="来源路径" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.Path, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.SelectedScanItem.HasSourceContext, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="来源应用" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.SourceContextText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.SelectedScanItem.HasAgePolicy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="年龄条件" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.AgePolicyText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.SelectedScanItem.IsLocked, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="占用状态" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.LockedByText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="分类" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.CategoryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="文件数量" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.FileCountText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="修改时间" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.ModifyTimeText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="执行方式" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedScanItem.ExecutionModeText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12"/>
                                                </Grid>
                                            </StackPanel>

                                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="清理后影响" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedScanItem.ImpactAfterCleanup, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.OpenItemLocationCommand}" CommandParameter="{x:Bind ViewModel.SelectedScanItem, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8DA;" FontSize="11"/><TextBlock Text="打开位置"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Cleanup.AddToExclusionsCommand}" CommandParameter="{x:Bind ViewModel.SelectedScanItem, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE71C;" FontSize="11"/><TextBlock Text="加入排除"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ══ Bottom Action Bar ══ -->
                        <Border Grid.Row="1" Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="计划处理" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.Scan.TotalSelectedSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Scan.TotalSelectedItemCountText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,5"
                                            Visibility="{x:Bind ViewModel.Scan.HasSelectedPermanentItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.Scan.SelectedPermanentSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{StaticResource AccentInspectBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,5"
                                            Visibility="{x:Bind ViewModel.Scan.HasSelectedRecoverableItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.Scan.SelectedRecoverableSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{StaticResource AccentPrimaryBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,5"
                                            Visibility="{x:Bind ViewModel.Scan.HasSelectedSystemItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.Scan.SelectedSystemSpaceText, Mode=OneWay}" Foreground="{StaticResource AccentPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{StaticResource AccentReviewBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,5"
                                            Visibility="{x:Bind ViewModel.Scan.HasSelectedReviewItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource AccentReview}"/>
                                            <TextBlock Text="{x:Bind ViewModel.Scan.BottomRiskHintText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,5"
                                            Visibility="{x:Bind ViewModel.Scan.ShowSafeHint, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource AccentSafe}"/>
                                            <TextBlock Text="{x:Bind ViewModel.Scan.BottomRiskHintText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Scan.StartQuickScanCommand}" IsEnabled="{x:Bind ViewModel.Scan.IsNotScanning, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE7C3;" FontSize="12" Foreground="{StaticResource AccentSafe}"/><TextBlock Text="重新扫描"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.RunCleanupCommand}" IsEnabled="{x:Bind ViewModel.Scan.CanRunCleanup, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74D;" FontSize="12"/><TextBlock Text="立即清理"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Cleanup owns a dedicated state surface so execution never looks frozen. -->
                        <Grid x:Name="CleanupExperience"
                              Canvas.ZIndex="20"
                              Opacity="0"
                              Background="{ThemeResource BgColor}"
                              Visibility="{x:Bind ViewModel.IsCleanupExperienceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                            <Border MaxWidth="640"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PanelSurfaceStrong}"
                                    BorderBrush="{ThemeResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="30,28">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="CleanupCardTransform" CenterX="320" CenterY="180"/>
                                </Border.RenderTransform>

                                <Grid>
                                    <!-- Active cleanup -->
                                    <StackPanel x:Name="CleanupRunningPanel"
                                                Spacing="18"
                                                Visibility="{x:Bind ViewModel.IsCleanupRunning, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                            <Border Width="50" Height="50" CornerRadius="25" Background="{ThemeResource AccentPrimaryBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ProgressRing x:Name="CleanupProgressRing" Width="64" Height="64" IsActive="False" Foreground="{ThemeResource AccentPrimary}"/>
                                        </Grid>

                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CleanupStageText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CleanupDetailText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"/>
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="处理进度" FontSize="11" Foreground="{ThemeResource TextMuted}"/>
                                                <TextBlock Text="{x:Bind ViewModel.CleanupProgressText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.CleanupProgressValue, Mode=OneWay}"
                                                         Maximum="{x:Bind ViewModel.CleanupProgressMax, Mode=OneWay}"
                                                         Height="7" CornerRadius="7"
                                                         Foreground="{ThemeResource AccentPrimary}"/>
                                        </StackPanel>

                                        <Border Background="{ThemeResource PanelSurface}" CornerRadius="8" Padding="12,10">
                                            <Grid ColumnSpacing="9">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource AccentSafe}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <TextBlock Grid.Column="1" Text="隔离和回收站项目仍可恢复；只有标记为永久处理的项目会立即释放空间。" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>

                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                Command="{x:Bind ViewModel.Scan.CancelCurrentOperationCommand}"
                                                HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE711;" FontSize="11"/><TextBlock Text="停止清理"/></StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Completion / interruption -->
                                    <StackPanel x:Name="CleanupOutcomePanel"
                                                Spacing="18"
                                                Visibility="{x:Bind ViewModel.IsCleanupOutcomeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel.RenderTransform><TranslateTransform x:Name="CleanupOutcomeTranslate"/></StackPanel.RenderTransform>

                                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                            <Border Width="58" Height="58" CornerRadius="29" Background="{ThemeResource AccentSafeBg}"
                                                    Visibility="{x:Bind ViewModel.CleanupOutcomeHasFailures, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource AccentSafe}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="58" Height="58" CornerRadius="29" Background="{ThemeResource AccentReviewBg}"
                                                    Visibility="{x:Bind ViewModel.CleanupOutcomeHasFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="{ThemeResource AccentReview}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Grid.RenderTransform><ScaleTransform x:Name="CleanupOutcomeIconScale" CenterX="32" CenterY="32"/></Grid.RenderTransform>
                                        </Grid>

                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CleanupOutcomeTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CleanupOutcomeDetail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>
                                        </StackPanel>

                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock Text="立即释放" FontSize="10" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CleanupReleasedText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentSafe}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{ThemeResource BorderSubtle}"/>
                                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock Text="可恢复暂存" FontSize="10" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CleanupRecoverableText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentInspect}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="{ThemeResource BorderSubtle}"/>
                                            <StackPanel Grid.Column="4" Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock Text="未处理" FontSize="10" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CleanupFailedText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentReview}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryActionButtonStyle}" Command="{x:Bind ViewModel.DismissCleanupOutcomeCommand}">
                                                <TextBlock Text="查看剩余项目"/>
                                            </Button>
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Command="{x:Bind ViewModel.Cleanup.RestoreLatestCleanupCommand}"
                                                    IsEnabled="{x:Bind ViewModel.Cleanup.CanRestoreLatest, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.Cleanup.HasRestorableBatch, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Text="恢复最近清理"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- Tab 2: 规则与自动化 (双栏设置面板)                -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid x:Name="Tab2Content" Visibility="Collapsed">
                    <Grid Padding="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部分类导航，避免页面内部再嵌套一条侧边栏 -->
                        <Border Grid.Row="0" Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10">
                            <ListView x:Name="SettingsNav" SelectionMode="Single" SelectionChanged="SettingsNav_SelectionChanged"
                                      Background="Transparent"
                                      Padding="6"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ItemContainerStyle="{StaticResource SettingsNavItemStyle}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{StaticResource AccentInspect}"/>
                                        <TextBlock Text="规则库" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{StaticResource AccentSafe}"/>
                                        <TextBlock Text="定时保洁" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEA80;" FontSize="14" Foreground="{StaticResource AccentSafe}"/>
                                        <TextBlock Text="智能推荐" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{StaticResource AccentInspect}"/>
                                        <TextBlock Text="数据与同步" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7EF;" FontSize="14" Foreground="{StaticResource AccentInspect}"/>
                                        <TextBlock Text="权限模式" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>
                        </Border>

                        <!-- 分类内容 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Padding="4,16,4,4">
                            <StackPanel x:Name="SettingsContentPanel" Spacing="14">

                                <!-- ── 规则库 ── -->
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="规则库" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentInspectBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RulePackSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="规则包信息" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RulePackDetailText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RulePackSourceText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RulePackRefreshText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RulePackRemoteUriText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="操作" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RulePackHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.ImportRulePackCommand}"><TextBlock Text="导入规则包"/></Button>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.RefreshRulePackFromUrlCommand}"><TextBlock Text="从链接刷新"/></Button>
                                            </Grid>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.OpenRulePackDirectoryCommand}"><TextBlock Text="打开规则目录"/></Button>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.ClearExternalRulePackCommand}" IsEnabled="{x:Bind ViewModel.Rule.HasExternalRulePack, Mode=OneWay}"><TextBlock Text="恢复内置规则"/></Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── 定时保洁 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="定时保洁" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.Automation.AutomationSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Automation.AutomationModeText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="自动化设置" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <ToggleSwitch Header="到期提醒我进行清理"
                                                          IsOn="{x:Bind ViewModel.Settings.ReminderEnabled, Mode=TwoWay}"
                                                          AutomationProperties.Name="启用定期清理提醒"/>
                                            <ToggleSwitch Header="到期后自动暂存低风险项"
                                                          IsOn="{x:Bind ViewModel.Settings.AutoLowRiskCleanupEnabled, Mode=TwoWay}"
                                                          AutomationProperties.Name="启用低风险项自动可恢复暂存"/>
                                            <TextBlock Text="提醒周期" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                                            <ComboBox PlaceholderText="选择提醒周期"
                                                      ItemsSource="{x:Bind ViewModel.Settings.ReminderOptions}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Days"
                                                      SelectedValue="{x:Bind ViewModel.Settings.ReminderIntervalDays, Mode=TwoWay}"
                                                      AutomationProperties.Name="提醒周期"/>
                                            <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" Margin="0,4"/>
                                            <ToggleSwitch Header="隔离备份到期后自动永久删除"
                                                          IsOn="{x:Bind ViewModel.Settings.AutoPurgeQuarantineEnabled, Mode=TwoWay}"
                                                          AutomationProperties.Name="启用隔离区自动清理"/>
                                            <TextBlock Text="隔离备份保留期" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                                            <ComboBox PlaceholderText="选择保留期"
                                                      ItemsSource="{x:Bind ViewModel.Settings.QuarantineRetentionOptions}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Days"
                                                      SelectedValue="{x:Bind ViewModel.Settings.QuarantineRetentionDays, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind ViewModel.Settings.AutoPurgeQuarantineEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="隔离备份保留期"/>
                                            <TextBlock Text="关闭时隔离备份只会由你手动清空；开启后，到期批次会在下次启动时永久删除。"
                                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="调度信息" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Automation.AutomationNextActionText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Automation.AutomationLastActionText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Automation.AutomationScheduleText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Automation.AutomationScheduleDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Automation.AutomationHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Automation.RunAutomaticLowRiskCleanupNowCommand}" IsEnabled="{x:Bind ViewModel.Scan.CanRunAutomaticLowRiskCleanupNow, Mode=OneWay}"><TextBlock Text="立即执行一次低风险保洁"/></Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── 智能推荐 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="智能推荐" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.RecommendationHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.RecommendationDetailText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.RecommendationProfileText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendationEntries, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasRecommendationEntries, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CleanerRecommendationEntry">
                                                <Border Margin="0,0,0,6" Padding="12,10" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind ActionText}" Foreground="{StaticResource AccentInspect}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ── 数据与同步 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="数据与同步" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentInspectBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.Rule.RolloutSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Rule.RolloutDetailText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.Rule.RolloutHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="灰度通道" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.SetStableRolloutChannelCommand}" IsEnabled="{x:Bind ViewModel.Rule.CanChooseStableRollout, Mode=OneWay}"><TextBlock Text="稳定"/></Button>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.SetCanaryRolloutChannelCommand}" IsEnabled="{x:Bind ViewModel.Rule.CanChooseCanaryRollout, Mode=OneWay}"><TextBlock Text="灰度"/></Button>
                                                <Button Grid.Column="2" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.SetInternalRolloutChannelCommand}" IsEnabled="{x:Bind ViewModel.Rule.CanChooseInternalRollout, Mode=OneWay}"><TextBlock Text="内测"/></Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="遥测" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind ViewModel.Rule.TelemetrySummaryText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="13" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.TelemetryDetailText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                            <ToggleSwitch Header="遥测摘要"
                                                          IsOn="{x:Bind ViewModel.Settings.TelemetryEnabled, Mode=TwoWay}"
                                                          AutomationProperties.Name="启用匿名清理遥测摘要"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.TelemetryEndpointText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.TelemetryLastUploadText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.ConfigureTelemetryEndpointCommand}"><TextBlock Text="配置上传地址"/></Button>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.UploadTelemetryNowCommand}" IsEnabled="{x:Bind ViewModel.Rule.CanUploadTelemetryNow, Mode=OneWay}"><TextBlock Text="立即上传摘要"/></Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── 权限模式 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="权限模式" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentInspectBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.PrivilegeModeText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="说明" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.PrivilegeModeHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Text="{x:Bind ViewModel.SystemBoundaryHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.EnterElevatedModeCommand}" Visibility="{x:Bind ViewModel.CanEnterElevatedMode, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7EF;" FontSize="11" Foreground="{StaticResource AccentInspect}"/><TextBlock Text="进入管理员模式"/></StackPanel>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- Tab 3: 历史与审计 (双栏设置面板)                  -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid x:Name="Tab3Content" Visibility="Collapsed">
                    <Grid Padding="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部记录分类 -->
                        <Border Grid.Row="0" Background="{StaticResource PanelSurface}" BorderThickness="0" CornerRadius="10">
                            <ListView x:Name="HistoryNav" SelectionMode="Single" SelectionChanged="HistoryNav_SelectionChanged"
                                      Background="Transparent"
                                      Padding="6"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ItemContainerStyle="{StaticResource SettingsNavItemStyle}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{StaticResource AccentSafe}"/>
                                        <TextBlock Text="本次计划" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7BC;" FontSize="14" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="运行摘要" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xECA5;" FontSize="14" Foreground="{StaticResource AccentInspect}"/>
                                        <TextBlock Text="空间趋势" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="最近清理" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="批次明细" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AccentReview}"/>
                                        <TextBlock Text="质量治理" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE71C;" FontSize="14" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="排除列表" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>
                        </Border>

                        <!-- 记录内容 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Padding="4,16,4,4">
                            <StackPanel x:Name="HistoryContentPanel" Spacing="14">

                                <!-- ── 本次计划 ── -->
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="本次计划" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.Scan.SelectedSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.Scan.LastScanText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                            <TextBlock Text="只会执行你当前勾选的项目；高风险对象默认不参与。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── 运行摘要 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="运行摘要" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="扫描" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind ViewModel.AuditScanSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="清理" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind ViewModel.AuditCleanupSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,6,0,0">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="恢复" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind ViewModel.AuditRestoreSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,6,0,0">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="重试" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind ViewModel.AuditRetrySummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="用户操作" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.AuditUserChoiceSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.AuditFailureSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── 空间趋势 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="空间趋势" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentInspectBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.ScanTrendHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ScanTrendDeltaText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="趋势详情" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.ScanTrendDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.ScanTrendCompositionText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.ScanTrendWindowText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.ScanTrendScopeText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.ScanTrendReuseText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ScanTrendEntries, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasScanTrendHistory, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CleanerScanTrendEntry">
                                                <Border Margin="0,0,0,6" Padding="12,10" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{x:Bind TimestampText}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{x:Bind ScopeText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind TotalText}" Foreground="{StaticResource AccentInspect}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind DeltaText}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind CompositionText}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind DriveSummaryText}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind ReuseText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ── 清理批次 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="清理批次" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                    <ComboBox Header="选择要查看或恢复的批次"
                                              ItemsSource="{x:Bind ViewModel.Cleanup.CleanupHistoryBatches, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.Cleanup.SelectedCleanupBatch, Mode=TwoWay}"
                                              DisplayMemberPath="SummaryText"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="选择清理历史批次"
                                              Visibility="{x:Bind ViewModel.Cleanup.HasCleanupHistory, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="批次摘要" Foreground="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Cleanup.LatestCleanupSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Text="{x:Bind ViewModel.Cleanup.LatestCleanupHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                            Visibility="{x:Bind ViewModel.Cleanup.HasLatestCleanupFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="失败处理建议" Foreground="{StaticResource AccentReview}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Cleanup.FailureRecoveryHeadlineText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Cleanup.FailureRecoveryDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.FailureRecoveryProcessText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFailureRecoveryProcesses, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Cleanup.RetryFailedCleanupEntriesCommand}" IsEnabled="{x:Bind ViewModel.Cleanup.CanStartHistoryOperation, Mode=OneWay}" Visibility="{x:Bind ViewModel.Cleanup.HasRetryableFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"><TextBlock Text="重试失败项"/></Button>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.EnterElevatedModeAndRetryFailuresCommand}" Visibility="{x:Bind ViewModel.CanElevateAndRetryFailures, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"><TextBlock Text="{x:Bind ViewModel.FailureRecoveryElevateActionText, Mode=OneWay}"/></Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="6">
                                        <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Cleanup.RestoreLatestCleanupCommand}" IsEnabled="{x:Bind ViewModel.Cleanup.CanRestoreLatest, Mode=OneWay}" AutomationProperties.Name="恢复所选清理批次"><TextBlock Text="恢复所选批次"/></Button>
                                        <Button Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Cleanup.PurgeQuarantineCommand}" IsEnabled="{x:Bind ViewModel.Cleanup.CanPurgeQuarantine, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                <TextBlock Text="{x:Bind ViewModel.Cleanup.QuarantineSummaryText, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Button>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Cleanup.OpenQuarantineCommand}"><TextBlock Text="打开隔离区"/></Button>
                                            <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.OpenCleanerWorkspaceCommand}"><TextBlock Text="打开记录目录"/></Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ── 批次明细 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="所选批次明细" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Cleanup.LatestCleanupEntries, Mode=OneWay}" Visibility="{x:Bind ViewModel.Cleanup.HasLatestCleanupEntries, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CleanerCleanupEntry">
                                                <Border Margin="0,0,0,6" Padding="12,10" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                    <StackPanel Spacing="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{x:Bind ItemName}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{x:Bind StatusText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Top">
                                                                <TextBlock Text="{x:Bind SizeText}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind FailureSummary}" Visibility="{x:Bind HasFailure, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind ErrorMessage}" Visibility="{x:Bind HasFailure, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind RecoveryHint}" Visibility="{x:Bind HasRecoveryHint, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentInspect}" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ViewModel.Cleanup.OpenCleanupEntryOriginalPathCommand, ElementName=RootPage}" CommandParameter="{Binding}" Padding="5,4" MinHeight="0" ToolTipService.ToolTip="原位置" AutomationProperties.Name="打开原位置">
                                                                <FontIcon Glyph="&#xE8DA;" FontSize="11"/>
                                                            </Button>
                                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ViewModel.Cleanup.OpenCleanupEntryBackupPathCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind HasBackupPath, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Padding="5,4" MinHeight="0" ToolTipService.ToolTip="隔离区" AutomationProperties.Name="打开隔离区备份">
                                                                <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                                                            </Button>
                                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ViewModel.Cleanup.RestoreCleanupEntryCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind CanRestoreEntry, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" IsEnabled="{Binding ViewModel.Cleanup.CanStartHistoryOperation, ElementName=RootPage}" Padding="5,4" MinHeight="0" ToolTipService.ToolTip="恢复此项" AutomationProperties.Name="恢复此清理项">
                                                                <FontIcon Glyph="&#xE7A7;" FontSize="11" Foreground="{StaticResource AccentSafe}"/>
                                                            </Button>
                                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ViewModel.Rule.DisableRuleFromCleanupEntryCommand, ElementName=RootPage}" CommandParameter="{Binding}" Visibility="{x:Bind CanDisableRule, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Padding="5,4" MinHeight="0" ToolTipService.ToolTip="停用规则" AutomationProperties.Name="停用对应清理规则">
                                                                <FontIcon Glyph="&#xE7AC;" FontSize="11" Foreground="{StaticResource AccentReview}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="无批次明细记录" Foreground="{StaticResource TextMuted}" FontSize="13"
                                               Visibility="{x:Bind ViewModel.Cleanup.HasLatestCleanupEntries, Mode=OneWay, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                                </StackPanel>

                                <!-- ── 质量治理 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="质量治理" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="{StaticResource AccentReviewBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceHeadlineText, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceDetailText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceHintText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.ExportDiagnosticReportCommand}"><TextBlock Text="导出诊断报告"/></Button>
                                        <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{x:Bind ViewModel.Rule.EnableAllLocallyDisabledRulesCommand}" IsEnabled="{x:Bind ViewModel.Rule.HasLocallyDisabledRules, Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.Rule.QualityGovernanceActionText, Mode=OneWay}"/></Button>
                                    </Grid>
                                </StackPanel>

                                <!-- ── 排除列表 ── -->
                                <StackPanel Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="排除列表" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                                    <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind ViewModel.Cleanup.ExclusionSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Cleanup.Exclusions, Mode=OneWay}" Visibility="{x:Bind ViewModel.Cleanup.HasExclusions, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CleanerExclusionEntry">
                                                <Border Margin="0,0,0,6" Padding="12,10" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{x:Bind DisplayName}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource CompactButtonStyle}" Command="{Binding ViewModel.Cleanup.RemoveExclusionCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="移除"/></Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="在任意清理项上点击「加入排除」后，后续扫描将跳过该路径。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Page>
