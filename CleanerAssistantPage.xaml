<Page
    x:Class="BlueSapphire.CleanerAssistantPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire"
    xmlns:models="using:BlueSapphire.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>

        <SolidColorBrush x:Key="BgColor" Color="#091114"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#0D171B"/>
        <SolidColorBrush x:Key="PanelSurfaceStrong" Color="#101E23"/>
        <SolidColorBrush x:Key="PanelHighlight" Color="#123039"/>
        <SolidColorBrush x:Key="TextMain" Color="#E4F2EF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7A9796"/>
        <SolidColorBrush x:Key="AccentSafe" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentSafeBg" Color="#1422C55E"/>
        <SolidColorBrush x:Key="AccentReview" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentReviewBg" Color="#18F59E0B"/>
        <SolidColorBrush x:Key="AccentInspect" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentInspectBg" Color="#1638BDF8"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelHighlight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="CardBorderStrongStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurfaceStrong}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="ListItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="26,18,26,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SPACE GOVERNANCE" FontSize="10" Foreground="{StaticResource TextMuted}" CharacterSpacing="120"/>
                <TextBlock Text="清理助手" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                <TextBlock Text="先解释空间，再执行清理；默认保守，支持恢复和排除。" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Scan.StartQuickScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C3;" Foreground="{StaticResource AccentSafe}"/>
                        <TextBlock Text="快速扫描"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Scan.StartDeepScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE81E;" Foreground="{StaticResource AccentInspect}"/>
                        <TextBlock Text="深度扫描"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{x:Bind ViewModel.RunCleanupCommand}"
                        Background="{StaticResource AccentSafeBg}"
                        BorderBrush="{StaticResource AccentSafe}"
                        IsEnabled="{x:Bind ViewModel.Scan.CanRunCleanup, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AccentSafe}"/>
                        <TextBlock Text="执行清理" Foreground="{StaticResource AccentSafe}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" Margin="26,18,26,24">
            <TabView.TabItems>
                <TabViewItem Header="扫描与清理" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Padding="0,0,16,0">
                        <StackPanel Spacing="18">

                            <Border Background="{StaticResource PanelSurfaceStrong}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,14"
                                    Visibility="{x:Bind ViewModel.Drive.HasDriveOptions, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="扫描范围" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.Drive.SelectedDriveSummaryText, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="13" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Drive.UseSystemDriveOnlyCommand}" ToolTipService.ToolTip="仅系统盘">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7FA;" FontSize="12"/><TextBlock Text="系统盘" FontSize="12"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionButtonStyle}" Command="{x:Bind ViewModel.Drive.SelectAllDrivesCommand}" ToolTipService.ToolTip="全选">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73A;" FontSize="12"/><TextBlock Text="全选" FontSize="12"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Drive.DriveOptions, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CleanerDriveOption">
                                                    <Border Width="260" Padding="16,16,16,14" Background="#0AFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{StaticResource TextMuted}"/>
                                                                    <TextBlock Text="{x:Bind TitleText}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <CheckBox Grid.Column="1" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" MinHeight="0" Margin="0,-4,-4,0" Padding="0"/>
                                                            </Grid>
                                                            
                                                            <TextBlock Grid.Row="1" Text="{x:Bind SubtitleText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="24,2,0,16"/>
                                                            
                                                            <StackPanel Grid.Row="3" Spacing="8" VerticalAlignment="Bottom">
                                                                <Grid>
                                                                    <TextBlock Text="空间使用情况" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="{x:Bind UsageText}" Foreground="{StaticResource AccentInspect}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <ProgressBar Value="{x:Bind UsedPercentage, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="999" Foreground="{StaticResource AccentInspect}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 卡片 1: 安全清理 -->
                                <Border Grid.Column="0" CornerRadius="16" BorderThickness="1" BorderBrush="#3022C55E">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1A22C55E" Offset="0"/>
                                            <GradientStop Color="#0522C55E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Spacing="8" Padding="16,14">
                                        <TextBlock Text="可安全清理" Foreground="{StaticResource AccentSafe}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.Scan.SafeSpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.Scan.SafeCountText, Mode=OneWay}" Foreground="#A022C55E" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2: 建议确认 -->
                                <Border Grid.Column="1" CornerRadius="16" BorderThickness="1" BorderBrush="#30F59E0B">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1AF59E0B" Offset="0"/>
                                            <GradientStop Color="#05F59E0B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Spacing="8" Padding="16,14">
                                        <TextBlock Text="建议确认后清理" Foreground="{StaticResource AccentReview}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.Scan.ReviewSpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.Scan.ReviewCountText, Mode=OneWay}" Foreground="#A0F59E0B" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 3: 仅查看 -->
                                <Border Grid.Column="2" CornerRadius="16" BorderThickness="1" BorderBrush="#3038BDF8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1A38BDF8" Offset="0"/>
                                            <GradientStop Color="#0538BDF8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Spacing="8" Padding="16,14">
                                        <TextBlock Text="仅供查看" Foreground="{StaticResource AccentInspect}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.Scan.ViewOnlySpaceText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.Scan.ViewOnlyCountText, Mode=OneWay}" Foreground="#A038BDF8" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                    <Border CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Padding="20,18" Margin="0,4,0,4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0AFFFFFF" Offset="0"/>
                                <GradientStop Color="#02FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Scan.StatusMainText, Mode=OneWay}" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.Scan.StatusDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="13" TextWrapping="Wrap"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind ViewModel.Scan.ProgressValue, Mode=OneWay}" Maximum="{x:Bind ViewModel.Scan.ProgressMax, Mode=OneWay}" Height="6" CornerRadius="999"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Scan.ScanModeText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{x:Bind ViewModel.Scan.CancelCurrentOperationCommand}"
                                        Visibility="{x:Bind ViewModel.Scan.CanCancelCurrentOperation, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                        Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="取消" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Expander Visibility="{x:Bind ViewModel.Scan.HasSafeItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,4"
                              IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                                <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource AccentSafe}" FontSize="16"/>
                                <TextBlock Text="可安全清理明细" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentSafeBg}" BorderThickness="1" BorderBrush="#3022C55E" CornerRadius="12" Padding="8,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Scan.SafeItemCount, Mode=OneWay}" Foreground="{StaticResource AccentSafe}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Expander.Header>
                        <ListView ItemsSource="{x:Bind ViewModel.Scan.SafeItems, Mode=OneWay}" SelectionMode="None" MaxHeight="500" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerScanItem">
                                    <Border Style="{StaticResource ListItemBorderStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentSafeBg}" BorderBrush="{StaticResource AccentSafe}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentSafe}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4">
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind SizeText}" Foreground="{StaticResource TextMain}" FontSize="11"/></Border>
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind CategoryText}" Foreground="{StaticResource TextMuted}" FontSize="11"/></Border>
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind ExecutionModeText}" Foreground="{StaticResource TextMuted}" FontSize="11"/></Border>
                                                    <Border Background="#0FFFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="999" Padding="8,4" Margin="0,0,8,8"><TextBlock Text="{x:Bind FileCountText}" Foreground="{StaticResource TextMuted}" FontSize="11"/></Border>
                                                </VariableSizedWrapGrid>
                                                <TextBlock Text="{x:Bind StatusHintText}" Foreground="{StaticResource AccentSafe}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind WhyItCanBeCleaned}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind OwnerApp}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenItemLocationCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="打开位置"/></Button>
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.Cleanup.AddToExclusionsCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="加入排除"/></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                    <Expander Visibility="{x:Bind ViewModel.Scan.HasReviewItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,4"
                              IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                                <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource AccentReview}" FontSize="16"/>
                                <TextBlock Text="建议确认后清理明细" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentReviewBg}" BorderThickness="1" BorderBrush="#30F59E0B" CornerRadius="12" Padding="8,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Scan.ReviewItems.Count, Mode=OneWay}" Foreground="{StaticResource AccentReview}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Expander.Header>
                        <ListView ItemsSource="{x:Bind ViewModel.Scan.ReviewItems, Mode=OneWay}" SelectionMode="None" MaxHeight="500" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanerScanItem">
                                    <Border Style="{StaticResource ListItemBorderStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectableAndEnabled}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource AccentReviewBg}" BorderBrush="{StaticResource AccentReview}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind RiskText}" Foreground="{StaticResource AccentReview}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind RiskSummary}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind LockedByText}" Visibility="{x:Bind HasLockOwnerInfo, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Foreground="{StaticResource AccentReview}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind ImpactAfterCleanup}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind OwnerApp}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.OpenItemLocationCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="打开位置"/></Button>
                                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewModel.Cleanup.AddToExclusionsCommand, ElementName=RootPage}" CommandParameter="{Binding}"><TextBlock Text="加入排除"/></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                    <Expander Visibility="{x:Bind ViewModel.Scan.HasViewOnlyItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,4"
                              IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                                <FontIcon Glyph="&#xE9ce;" Foreground="{StaticResource AccentInspect}" FontSize="16"/>
                                <TextBlock Text="仅供查看明细" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentInspectBg}" BorderThickness="1" BorderBrush="#3038BDF8" CornerRadius="12" Padding="8,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Scan.ViewOnlyItems.Count, Mode=OneWay}" Foreground="{StaticResource AccentInspect}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ViewOnlyDisplayHintText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasHiddenViewOnlyItems, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <ListView ItemsSource="{x:Bind ViewModel.Scan.ViewOnlyItems, Mode=OneWay}" SelectionMode="None" MaxHeight="500" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
