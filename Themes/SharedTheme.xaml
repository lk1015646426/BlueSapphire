<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueSapphire">

    <!-- Converters -->
    <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
    <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Color Brushes — Fluent neutral surfaces + sapphire accent -->
    <!-- ═══════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BgColor" Color="#0F1417"/>
    <SolidColorBrush x:Key="PanelSurface" Color="#151B1F"/>
    <SolidColorBrush x:Key="PanelSurfaceStrong" Color="#1A2227"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#222D33"/>
    <SolidColorBrush x:Key="PanelHighlight" Color="#27343B"/>
    <SolidColorBrush x:Key="BorderColor" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="BorderActive" Color="#46FFFFFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#F1F5F5"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B8C5C7"/>
    <SolidColorBrush x:Key="TextMuted" Color="#93A3A6"/>
    <SolidColorBrush x:Key="TextFaint" Color="#75868A"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#26AFC7"/>
    <SolidColorBrush x:Key="AccentCyanHover" Color="#38BBD1"/>
    <SolidColorBrush x:Key="AccentCyanPressed" Color="#1494AC"/>
    <SolidColorBrush x:Key="AccentCyanBg" Color="#2426AFC7"/>
    <SolidColorBrush x:Key="AccentSafe" Color="#43B581"/>
    <SolidColorBrush x:Key="AccentSafeBg" Color="#2043B581"/>
    <SolidColorBrush x:Key="AccentReview" Color="#D9A62E"/>
    <SolidColorBrush x:Key="AccentReviewBg" Color="#20D9A62E"/>
    <SolidColorBrush x:Key="AccentInspect" Color="#4AA6D8"/>
    <SolidColorBrush x:Key="AccentInspectBg" Color="#204AA6D8"/>
    <SolidColorBrush x:Key="AccentDanger" Color="#E46C7A"/>
    <SolidColorBrush x:Key="AccentDangerBg" Color="#24E46C7A"/>
    <SolidColorBrush x:Key="OverlayScrim" Color="#D90B0F12"/>
    <SolidColorBrush x:Key="MediaSurface" Color="#10161A"/>
    <SolidColorBrush x:Key="BadgeSurface" Color="#EA151B1F"/>

    <!-- Align native WinUI controls (toggle, check box, selection) with the app accent. -->
    <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AccentCyan"/>
    <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="AccentCyanHover"/>
    <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="AccentCyanPressed"/>
    <StaticResource x:Key="AccentFillColorSelectedTextBackgroundBrush" ResourceKey="AccentCyan"/>
    <StaticResource x:Key="AccentTextFillColorPrimaryBrush" ResourceKey="AccentCyan"/>
    <StaticResource x:Key="AccentTextFillColorSecondaryBrush" ResourceKey="AccentCyanHover"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Button Styles                                        -->
    <!-- ═══════════════════════════════════════════════════ -->

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource PanelSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderColor}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource BorderActive}"/>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource PanelHighlight}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource SurfaceElevated}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.42"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AccentCyan}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentCyan}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentCyan}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource AccentCyanHover}"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AccentCyanHover}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource AccentCyanPressed}"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AccentCyanPressed}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.42"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource TextOnAccent}"/>
                                        <Setter Target="ContentPresenter.BorderThickness" Value="2"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
    </Style>

    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentDangerBg}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentDangerBg}"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentDanger}"/>
    </Style>

    <!-- Compact button — for inline actions -->
    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Border / Card Styles                                -->
    <!-- ═══════════════════════════════════════════════════ -->

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="CardBorderStrongStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelSurfaceStrong}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <!-- Bento metric card — for dashboard stats -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelSurfaceStrong}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style x:Key="ListItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PanelSurfaceStrong}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="InfoChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TextBlock Styles                                     -->
    <!-- ═══════════════════════════════════════════════════ -->

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMuted}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <Style x:Key="TextStyle_Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <Style x:Key="TextStyle_Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMuted}"/>
    </Style>

    <Style x:Key="TextStyle_Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <Style x:Key="TextStyle_Large" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <!-- Unified page title — 24px, all pages should use this for main page headings -->
    <Style x:Key="TextStyle_PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <!-- Metric values — 28px for key numbers -->
    <Style x:Key="TextStyle_Metric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <!-- Display — 32px, reserved for HomePage branding/greeting only -->
    <Style x:Key="TextStyle_Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextMain}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Spacing Tokens (8-multiple system)                  -->
    <!-- ═══════════════════════════════════════════════════ -->

    <Thickness x:Key="PagePadding">24,20</Thickness>
    <Thickness x:Key="PagePaddingLarge">32,28</Thickness>
    <Thickness x:Key="CardPadding">18,16</Thickness>
    <Thickness x:Key="SectionGap">0,32,0,0</Thickness>
    <Thickness x:Key="SectionGapSmall">0,15,0,0</Thickness>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Chip Styles                                          -->
    <!-- ═══════════════════════════════════════════════════ -->

    <Style x:Key="SummaryChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentInspectBg}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentInspect}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Settings nav item style — for left-side section navigation -->
    <Style x:Key="SettingsNavItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource SurfaceElevated}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.7"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource AccentCyanBg}"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AccentCyan}"/>
                                        <Setter Target="ContentPresenter.BorderThickness" Value="0,0,0,0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource AccentCyanBg}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.35"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
